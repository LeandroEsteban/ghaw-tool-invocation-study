:"open","title":"DNS records for additional local IP addresses","type":{"color":"blue","created_at":"2024-01-25T09:11:09Z","description":"A request, idea, or new functionality","id":93574,"name":"Feature","node_id":"IT_kwDNuP_OAAFthg","updated_at":"2024-10-08T08:30:20Z"},"updated_at":"2026-05-10T02:17:03Z","url":"https://api.github.com/repos/apache/cloudstack/issues/2865","user":{"avatar_url":"https://avatars.githubusercontent.com/u/38244286?v=4","events_url":"https://api.github.com/users/IngoJochim/events{/privacy}","followers_url":"https://api.github.com/users/IngoJochim/followers","following_url":"https://api.github.com/users/IngoJochim/following{/other_user}","gists_url":"https://api.github.com/users/IngoJochim/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/IngoJochim","id":38244286,"login":"IngoJochim","node_id":"MDQ6VXNlcjM4MjQ0Mjg2","organizations_url":"https://api.github.com/users/IngoJochim/orgs","received_events_url":"https://api.github.com/users/IngoJochim/received_events","repos_url":"https://api.github.com/users/IngoJochim/repos","site_admin":false,"starred_url":"https://api.github.com/users/IngoJochim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IngoJochim/subscriptions","type":"User","url":"https://api.github.com/users/IngoJochim"}},{"author_association":"NONE","body":"\r\n##### ISSUE TYPE\r\n * Improvement Request\r\n\r\n##### COMPONENT NAME\r\n* ACS 4.11.x VR load balancing with AppCookie stickiness\r\n\r\n##### CLOUDSTACK VERSION\r\n* ACS 4.11.x\r\n\r\n##### CONFIGURATION\r\n* Advanced zone, guest isolated network with LB configuration on public IP\r\n\r\n\r\n##### OS / ENVIRONMENT\r\n* N/A\r\n\r\n##### SUMMARY\r\n* AppCookie configuration is deprecated in HAproxy\r\n* https://cbonte.github.io/haproxy-dconv/1.7/configuration.html#appsession\r\n\r\n##### STEPS TO REPRODUCE\r\n* Create new LB rule with AppCookie stickiness\r\n* Observe haproxy logs on VR stating:\r\n03:59:09 r-1667-VM haproxy[40552]: [ALERT] 090/035909 (40552) : parsing [/etc/haproxy/haproxy.cfg:38] : 'appsession' is not supported anymore, please check the documentation.\r\n\r\n##### EXPECTED RESULTS\r\n* N/A\r\n\r\n##### ACTUAL RESULTS\r\n* Error as above\r\n","comments":3,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/3253/comments","created_at":"2019-04-01T15:04:56Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/3253/events","html_url":"https://github.com/apache/cloudstack/issues/3253","id":427758451,"labels":[{"color":"a5f9ff","default":false,"description":"","id":817420428,"name":"type:improvement","node_id":"MDU6TGFiZWw4MTc0MjA0Mjg=","url":"https://api.github.com/repos/apache/cloudstack/labels/type:improvement"},{"color":"0e8a16","default":false,"description":"","id":821716113,"name":"type:cleanup","node_id":"MDU6TGFiZWw4MjE3MTYxMTM=","url":"https://api.github.com/repos/apache/cloudstack/labels/type:cleanup"},{"color":"903636","default":false,"description":"","id":1663969521,"name":"Severity:Major","node_id":"MDU6TGFiZWwxNjYzOTY5NTIx","url":"https://api.github.com/repos/apache/cloudstack/labels/Severity:Major"},{"color":"E43179","default":false,"description":"","id":6890295339,"name":"status:stale","node_id":"LA_kwDOAJTq2M8AAAABmrGQKw","url":"https://api.github.com/repos/apache/cloudstack/labels/status:stale"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/3253/labels{/name}","locked":false,"milestone":{"closed_issues":116,"created_at":"2026-04-13T07:02:43Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/12028987?v=4","events_url":"https://api.github.com/users/sureshanaparti/events{/privacy}","followers_url":"https://api.github.com/users/sureshanaparti/followers","following_url":"https://api.github.com/users/sureshanaparti/following{/other_user}","gists_url":"https://api.github.com/users/sureshanaparti/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/sureshanaparti","id":12028987,"login":"sureshanaparti","node_id":"MDQ6VXNlcjEyMDI4OTg3","organizations_url":"https://api.github.com/users/sureshanaparti/orgs","received_events_url":"https://api.github.com/users/sureshanaparti/received_events","repos_url":"https://api.github.com/users/sureshanaparti/repos","site_admin":false,"starred_url":"https://api.github.com/users/sureshanaparti/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sureshanaparti/subscriptions","type":"User","url":"https://api.github.com/users/sureshanaparti"},"description":"","html_url":"https://github.com/apache/cloudstack/milestone/46","id":15514689,"labels_url":"https://api.github.com/repos/apache/cloudstack/milestones/46/labels","node_id":"MI_kwDOAJTq2M4A7LxB","number":46,"open_issues":264,"state":"open","title":"4.22.2","updated_at":"2026-10-01T15:03:42Z","url":"https://api.github.com/repos/apache/cloudstack/milestones/46"},"node_id":"MDU6SXNzdWU0Mjc3NTg0NTE=","number":3253,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/apache/cloudstack/issues/3253/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","state_reason":"reopened","title":"Load balancer appcookie configuration deprecated in HAproxy","updated_at":"2026-05-26T15:48:25Z","url":"https://api.github.com/repos/apache/cloudstack/issues/3253","user":{"avatar_url":"https://avatars.githubusercontent.com/u/12859582?v=4","events_url":"https://api.github.com/users/DagSonsteboSB/events{/privacy}","followers_url":"https://api.github.com/users/DagSonsteboSB/followers","following_url":"https://api.github.com/users/DagSonsteboSB/following{/other_user}","gists_url":"https://api.github.com/users/DagSonsteboSB/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/DagSonsteboSB","id":12859582,"login":"DagSonsteboSB","node_id":"MDQ6VXNlcjEyODU5NTgy","organizations_url":"https://api.github.com/users/DagSonsteboSB/orgs","received_events_url":"https://api.github.com/users/DagSonsteboSB/received_events","repos_url":"https://api.github.com/users/DagSonsteboSB/repos","site_admin":false,"starred_url":"https://api.github.com/users/DagSonsteboSB/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DagSonsteboSB/subscriptions","type":"User","url":"https://api.github.com/users/DagSonsteboSB"}},{"author_association":"CONTRIBUTOR","body":"\u003c!--\nVerify first that your issue/request is not already reported on GitHub.\nAlso test if the latest release and master branch are affected too.\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\n--\u003e\nthe parameter name 'details' can mean different things in different API calls. These should be aligned and/or renamed. see the discussion in #3331\n\n##### ISSUE TYPE\n * Improvement Request\n\n##### COMPONENT NAME\n\u003c!--\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\n--\u003e\n~~~\nAPI\n~~~\n\n##### CLOUDSTACK VERSION\n\u003c!--\nNew line separated list of affected versions, commit ID for issues on master branch.\n--\u003e\n\n~~~\nall\n~~~\n\n##### SUMMARY\n\n\n| type of details field | class |\n| - | -  |\n| | Commands: |\n| Map | RegisterOAuthProviderCmd.java |\nMap | BaseUpdateTemplateOrIsoCmd.java\nList\\\u003cString\u003e | ListHostsCmd.java\nMap | UpdateZoneCmd.java\nMap | CreateNetworkOfferingCmd.java\nMap | UpdateBgpPeerCmd.java\nMap | CreateBgpPeerCmd.java\nMap\u003cString, String\u003e | UpgradeSystemVMCmd.java\nMap\u003cString, String\u003e | ScaleSystemVMCmd.java\nMap | UpdateStoragePoolCmd.java\nMap | UpdateCloudToUseObjectStoreCmd.java\nMap | AddImageStoreCmd.java\nMap\u003cString, ? extends Map\u003cString, String\u003e\u003e | CreateSecondaryStagingStoreCmd.java\nMap | AddObjectStoragePoolCmd.java\nMap | CreateStoragePoolCmd.java\nMap\u003cString, String\u003e | ImportUnmanagedInstanceCmd.java\nMap | AddGuestOsCmd.java\nMap | UpdateGuestOsCmd.java\nMap | CreateDiskOfferingCmd.java\n| List\\\u003cString\u003e | ListDomainsCmd.java\nMap | CreateTemplateCmd.java\nMap | GetUploadParamsForTemplateCmd.java\nMap | RegisterTemplateCmd.java\nList\\\u003cString\u003e | ListTemplatesCmd.java\nList\\\u003cString\u003e | ListProjectsCmd.java\nMap\u003cString, String\u003e | UpgradeVMCmd.java\nList\\\u003cString\u003e | ListVMsCmd.java\nMap | DeployVMCmd.java\nMap\u003cString, String\u003e | UpdateVMCmd.java\nMap | RestoreVMCmd.java\n| Map\u003cString, String\u003e | ScaleVMCmd.java |\n| List\\\u003cString\u003e | ListAccountsCmd.java |\n| Map | AddResourceDetailCmd.java |\n| | Responses: |\n| Map\u003cString, String\u003e | TemplateResponse.java |\nMap | NetworkOfferingResponse.java\nMap | VolumeForImportResponse.java\nString | DirectDownloadCertificateHostStatusResponse.java\nMap | NetworkProtocolResponse.java\nMap | UserVmResponse.java\nMap | BgpPeerResponse.java\nMap\u003cString, String\u003e | DiskOfferingResponse.java\nMap | NetworkResponse.java\nString | CreateConsoleEndpointResponse.java\nString | RouterHealthCheckResultResponse.java\nMap\u003cString, List\\\u003cString\u003e\u003e | DetailOptionsResponse.java\nMap | HostResponse.java\nString | UnmanageVMInstanceResponse.java\n\nIn addtion to these there are some details related parameters that also have different types i.e. \u003csome entity type\u003edetails and some of them even as boolean.\n\nThere are two improvements to make here:\n1. make sure there are no ambiguities for users when they encounter a in- or output field named “details”\n2. make sure maintainers do not mix different patterns for the same basic functionality\nthe first being the more important one\n\nIn addition to all this there are backwards compatibility concerns. Some can be changed “under the hood” others will have to be marked as “deprecated\" to the user and and copied into a in-/output field with a new name, only considering the old one if the new one is missing.\n\n##### EXPECTED RESULTS\nA clear pattern from both user and developer point of view.\n\n","comments":4,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/3360/comments","created_at":"2019-05-28T08:46:51Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/3360/events","html_url":"https://github.com/apache/cloudstack/issues/3360","id":449140959,"labels":[{"color":"a5f9ff","default":false,"description":"","id":817420428,"name":"type:improvement","node_id":"MDU6TGFiZWw4MTc0MjA0Mjg=","url":"https://api.github.com/repos/apache/cloudstack/labels/type:improvement"},{"color":"0e8a16","default":false,"description":"","id":821716113,"name":"type:cleanup","node_id":"MDU6TGFiZWw4MjE3MTYxMTM=","url":"https://api.github.com/repos/apache/cloudstack/labels/type:cleanup"},{"color":"52a8ea","default":false,"description":"","id":1900337335,"name":"type:technical-debt","node_id":"MDU6TGFiZWwxOTAwMzM3MzM1","url":"https://api.github.com/repos/apache/cloudstack/labels/type:technical-debt"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/3360/labels{/name}","locked":false,"milestone":{"closed_issues":81,"created_at":"2026-01-21T11:18:05Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/2486961?v=4","events_url":"https://api.github.com/users/DaanHoogland/events{/privacy}","followers_url":"https://api.github.com/users/DaanHoogland/followers","following_url":"https://api.github.com/users/DaanHoogland/following{/other_user}","gists_url":"https://api.github.com/users/DaanHoogland/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/DaanHoogland","id":2486961,"login":"DaanHoogland","node_id":"MDQ6VXNlcjI0ODY5NjE=","organizations_url":"https://api.github.com/users/DaanHoogland/orgs","received_events_url":"https://api.github.com/users/DaanHoogland/received_events","repos_url":"https://api.github.com/users/DaanHoogland/repos","site_admin":false,"starred_url":"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}","subscriptions_url":"https://api.gith