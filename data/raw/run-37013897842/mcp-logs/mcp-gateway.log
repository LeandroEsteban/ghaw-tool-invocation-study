nned","updated_at":"2026-09-24T11:01:33Z","url":"https://api.github.com/repos/apache/cloudstack/milestones/19"},"node_id":"I_kwDOAJTq2M5GXL0k","number":6163,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/apache/cloudstack/issues/6163/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","title":"Add Support IPAM object to Allow Load Balancer or Port-forward map to floating IP Address","type":{"color":"blue","created_at":"2024-01-25T09:11:09Z","description":"A request, idea, or new functionality","id":93574,"name":"Feature","node_id":"IT_kwDNuP_OAAFthg","updated_at":"2024-10-08T08:30:20Z"},"updated_at":"2026-05-19T02:18:08Z","url":"https://api.github.com/repos/apache/cloudstack/issues/6163","user":{"avatar_url":"https://avatars.githubusercontent.com/u/36956864?v=4","events_url":"https://api.github.com/users/levindecaro/events{/privacy}","followers_url":"https://api.github.com/users/levindecaro/followers","following_url":"https://api.github.com/users/levindecaro/following{/other_user}","gists_url":"https://api.github.com/users/levindecaro/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/levindecaro","id":36956864,"login":"levindecaro","node_id":"MDQ6VXNlcjM2OTU2ODY0","organizations_url":"https://api.github.com/users/levindecaro/orgs","received_events_url":"https://api.github.com/users/levindecaro/received_events","repos_url":"https://api.github.com/users/levindecaro/repos","site_admin":false,"starred_url":"https://api.github.com/users/levindecaro/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/levindecaro/subscriptions","type":"User","url":"https://api.github.com/users/levindecaro"}},{"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/326786?v=4","events_url":"https://api.github.com/users/wido/events{/privacy}","followers_url":"https://api.github.com/users/wido/followers","following_url":"https://api.github.com/users/wido/following{/other_user}","gists_url":"https://api.github.com/users/wido/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/wido","id":326786,"login":"wido","node_id":"MDQ6VXNlcjMyNjc4Ng==","organizations_url":"https://api.github.com/users/wido/orgs","received_events_url":"https://api.github.com/users/wido/received_events","repos_url":"https://api.github.com/users/wido/repos","site_admin":false,"starred_url":"https://api.github.com/users/wido/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wido/subscriptions","type":"User","url":"https://api.github.com/users/wido"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/326786?v=4","events_url":"https://api.github.com/users/wido/events{/privacy}","followers_url":"https://api.github.com/users/wido/followers","following_url":"https://api.github.com/users/wido/following{/other_user}","gists_url":"https://api.github.com/users/wido/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/wido","id":326786,"login":"wido","node_id":"MDQ6VXNlcjMyNjc4Ng==","organizations_url":"https://api.github.com/users/wido/orgs","received_events_url":"https://api.github.com/users/wido/received_events","repos_url":"https://api.github.com/users/wido/repos","site_admin":false,"starred_url":"https://api.github.com/users/wido/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wido/subscriptions","type":"User","url":"https://api.github.com/users/wido"}],"author_association":"CONTRIBUTOR","body":"##### ISSUE TYPE\r\n * Enhancement Request\r\n\r\n##### COMPONENT NAME\r\n~~~\r\nCloudStack Agent\r\n~~~\r\n\r\n##### CLOUDSTACK VERSION\r\n~~~\r\nall\r\n~~~\r\n\r\n##### SUMMARY\r\nThe CloudStack Agent uses com.ceph.rados.* for many operations as when implementing the RBD storage pool support not all features were supported by Libvirt.\r\n\r\nFor example: https://github.com/apache/cloudstack/blob/[REDACTED]/plugins/hypervisors/kvm/src/main/java/com/cloud/hypervisor/kvm/storage/LibvirtStorageAdaptor.java#L913\r\n\r\n```\r\n                IoCTX io = r.ioCtxCreate(pool.getSourceDir());\r\n                Rbd rbd = new Rbd(io);\r\n                RbdImage image = rbd.open(uuid);\r\n                s_logger.debug(\"Fetching list of snapshots of RBD image \" + pool.getSourceDir() + \"/\" + uuid);\r\n                List\u003cRbdSnapInfo\u003e snaps = image.snapList();\r\n                try {\r\n                    for (RbdSnapInfo snap : snaps) {\r\n                        if (image.snapIsProtected(snap.name)) {\r\n                            s_logger.debug(\"Unprotecting snapshot \" + pool.getSourceDir() + \"/\" + uuid + \"@\" + snap.name);\r\n                            image.snapUnprotect(snap.name);\r\n                        } else {\r\n                            s_logger.debug(\"Snapshot \" + pool.getSourceDir() + \"/\" + uuid + \"@\" + snap.name + \" is not protected.\");\r\n                        }\r\n                        s_logger.debug(\"Removing snapshot \" + pool.getSourceDir() + \"/\" + uuid + \"@\" + snap.name);\r\n                        image.snapRemove(snap.name);\r\n                    }\r\n                    s_logger.info(\"Successfully unprotected and removed any remaining snapshots (\" + snaps.size() + \") of \"\r\n                        + pool.getSourceDir() + \"/\" + uuid + \" Continuing to remove the RBD image\");\r\n                } catch (RbdException e) {\r\n                    s_logger.error(\"Failed to remove snapshot with exception: \" + e.toString() +\r\n                        \", RBD error: \" + ErrorCode.getErrorMessage(e.getReturnValue()));\r\n                    throw new CloudRuntimeException(e.toString() + \" - \" + ErrorCode.getErrorMessage(e.getReturnValue()));\r\n                } finally {\r\n                    s_logger.debug(\"Closing image and destroying context\");\r\n                    rbd.close(image);\r\n                    r.ioCtxDestroy(io);\r\n                }\r\n            } catch (RadosException e) {\r\n                s_logger.error(\"Failed to remove snapshot with exception: \" + e.toString() +\r\n                    \", RBD error: \" + ErrorCode.getErrorMessage(e.getReturnValue()));\r\n                throw new CloudRuntimeException(e.toString() + \" - \" + ErrorCode.getErrorMessage(e.getReturnValue()));\r\n            } catch (RbdException e) {\r\n                s_logger.error(\"Failed to remove snapshot with exception: \" + e.toString() +\r\n                    \", RBD error: \" + ErrorCode.getErrorMessage(e.getReturnValue()));\r\n                throw new CloudRuntimeException(e.toString() + \" - \" + ErrorCode.getErrorMessage(e.getReturnValue()));\r\n            }\r\n        }\r\n```\r\n\r\nHere the CloudStack agent purges any RBD snapshots as they need to be removed prior to removing the RBD image.\r\n\r\nModern libvirt can do this for you (pseudo code):\r\n\r\n```\r\nStorageVol.delete(VIR_STORAGE_VOL_DELETE_WITH_SNAPSHOTS)\r\n```\r\n\r\nThis removes a lot of lines of code from CloudStack and leverages what libvirt can do for us.\r\n\r\nThis is just one example, but there are other places where the CloudStack agent uses the librados Java bindings directly while those things can be handled by libvirt.\r\n\r\n","comments":1,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/6180/comments","created_at":"2022-03-30T19:56:24Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/6180/events","html_url":"https://github.com/apache/cloudstack/issues/6180","id":1186920656,"labels":[{"color":"bfdadc","default":false,"description":"","id":584073028,"name":"component:ceph","node_id":"MDU6TGFiZWw1ODQwNzMwMjg=","url":"https://api.github.com/repos/apache/cloudstack/labels/component:ceph"},{"color":"80e5e2","default":false,"description":"","id":1092869943,"name":"component:agent","node_id":"MDU6TGFiZWwxMDkyODY5OTQz","url":"https://api.github.com/repos/apache/cloudstack/labels/component:agent"},{"color":"52a8ea","default":false,"description":"","id":1900337335,"name":"type:technical-debt","node_id":"MDU6TGFiZWwxOTAwMzM3MzM1","url":"https://api.github.com/repos/apache/cloudstack/labels/type:technical-debt"},{"color":"0000ff","default":false,"description":"a few months to a year or more, with more people","id":2531620895,"name":"complexity:epic","node_id":"MDU6TGFiZWwyNTMxNjIwODk1","url":"https://api.github.com/repos/apache/cloudstack/labels/complexity:epic"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/6180/labels{/name}","locked":false,"milestone":{"closed_issues":39,"created_at":"2026-05-08T06:15:20Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/57355700?v=4","events_url":"https://api.github.com/users/weizhouapache/events{/privacy}","followers_url":"https://api.github.com/users/weizhouapache/followers","following_url":"https://api.github.com/users/weizhouapache/following{/other_user}","gists_url":"https://api.github.com/users/weizhouapache/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/weizhouapache","id":57355700,"login":"weizhouapache","node_id":"MDQ6VXNlcjU3MzU1NzAw","organizations_url":"https://api.github.com/users/weizhouapache/orgs","received_events_url":"https://api.github.com/users/weizhouapache/received_events","repos_url":"https://api.github.com/users/weizhouapache/repos","site_admin":false,"starred_url":"https://api.github.com/users/weizhouapache/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/weizhouapache/subscriptions","type":"User","url":"https://api.github.com/users/weizhouapache"},"description":"","html_url":"https://github.com/apache/cloudstack/milestone/47","id":15843055,"labels_url":"https://api.github.com/repos/apache/cloudstack/milestones/47/labels","node_id":"MI_kwDOAJTq2M4A8b7v","number":47,"open_issues":274,"state":"open","title":"24.0","updated_at":"2026-10-02T08:13:00Z","url":"https://api.github.com/repos/apache/cloudstack/milestones/47"},"node_id":"I_kwDOAJTq2M5GvvjQ","number":6180,"reactions":{"+1":1,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":1,"url":"https://api.github.com/repos/apache/cloudstack/issues/6180/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","title":"RBD/RADOS volume management should be handled by libvirt","type":{"color":"yellow","created_at":"2024-01-25T09:11:09Z","description":"A specific piece of work","id":93568,"name":"Task","node_id":"IT_kwDNuP_OAAFtgA","updated_at":"2024-07-26T10:04:57Z"},"updated_at":"2026-05-21T10:09:12Z","url":"https://api.github.com/repos/apache/cloudstack/issues/6180","user":{"avatar_url":"https://avatars.githubusercontent.com/u/326786?v=4","events_url":"https://api.github.com/users/wido/events{/privacy}","followers_url":"https://api.github.com/users/wido/followers","following_url":"https://api.github.com/users/wido/following{/other_user}","gists_url":"https://api.github.com/users/wido/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/wido","id":326786,"login":"wido","node_id":"MDQ6VXNlcjMyNjc4Ng==","organizations_url":"https://api.github.com/users/wido/orgs","received_events_url":"https://api.github.com/users/wido/received_events","repos_url":"https://api.github.com/users/wido/repos","site_admin":false,"starred_url":"https://api.github.com/users/wido/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wido/subscriptions","type":"User","url":"https://api.github.com/users/wido"}},{"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/2357012?v=4","events_url":"https://api.github.com/users/NuxRo/events{/privacy}","followers_url":"https://api.github.com/users/NuxRo/followers","following_url":"https://api.github.com/users/NuxRo/following{/other_user}","gists_url":"https://api.github.com/users/NuxRo/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/NuxRo","id":2357012,"login":"NuxRo","node_id":"MDQ6VXNlcjIzNTcwMTI=","organizations_url":"https://api.github.com/users/NuxRo/orgs","received_events_url":"https://api.github.com/users/NuxRo/received_events","repos_url":"https://api.github.com/users/NuxRo/repos","site_admin":false,"starred_url":"https://api.github.com/users/NuxRo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NuxRo/subscriptions","type":"User","url":"https://api.github.com/users/NuxRo"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/2357012?v=4","events_url":"https://api.github.com/users/NuxRo/events{/privacy}","followers_url":"https://api.github.com/users/NuxRo/followers","following_url":"https://api.github.com/users/NuxRo/following{/other_user}","gists_url":"https://api.github.com/users/NuxRo/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/NuxRo","id":2357012,"login":"NuxRo","node_id":"MDQ6VXNlcjIzNTcwMTI=","organizations_url":"https://api.github.com/users/NuxRo/orgs","received_events_url":"https://api.github.com/users/NuxRo/received_events","repos_url":"https://api.github.com/users/NuxRo/repos","site_admin":false,"starred_url":"https://api.github.com/users/NuxRo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NuxRo/subscriptions","type":"User","url":"https://api.github.com/users/NuxRo"}],"author_association":"NONE","body":"\u003c!--\r\nVerify first that your issue/request is not already reported on GitHub.\r\nAlso test if the latest release and main branch are affected too.\r\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\r\n--\u003e\r\n\r\n##### ISSUE TYPE\r\n * Enhancement Request\r\n\r\n##### COMPONENT NAME\r\nAPI, VR\r\n\r\n##### CLOUDSTACK VERSION\r\n\u003c!--\r\nNew line separated list of affected versions, commit ID for issues on main branch.\r\n--\u003e\r\n\r\n~~~\r\n4.16.0.0\r\n~~~\r\nBut after my research, not available in current versions.\r\n\r\n##### CONFIGURATION\r\nN/A\r\n\r\n\r\n##### OS / ENVIRONMENT\r\nN/A\r\n\r\n\r\n##### SUMMARY\r\nFor monitoring of Virtual Routers, there seems to be no way of having the health check results in Prometheus metrics endpoint.\r\n\r\nCurrently, we are querying health check results with a pull based method for every Virtual Router, that is really inefficient on a large scale of routers.\r\n\r\n##### STEPS TO REPRODUCE\r\n- Enable Prometheus Metrics\r\n- Enable VR Health Checks\r\n- Query CloudStack `/metrics` endpoint\r\n\r\n##### EXPECTED RESULTS\r\nHave VR health check metrics exported at the `/metrics` endpoint.\r\n\r\nI thought of something like this, according to the current output of `getRouterHealthCheckResults`:\r\n\r\n~~~ini\r\n# TYPE cloudstack_virtualrouter_healthcheck_result stateset\r\n# HELP cloudstack_virtualrouter_healthcheck_result Virtual Router Health Check result\r\ncloudstack_virtualrouter_healthcheck_result{checkname=\"connectivity.test\",zone=\"zone1\",virtualrouter=\"i-123456-VM\",network=\"test-network\"} 1\r\n\r\n# TYPE cloudstack_virtualrouter_healthcheck_lastcheck gauge\r\n# HELP cloudstack_virtualrouter_healthcheck_lastcheck Virtual Router Health Check lastcheck timestamp\r\n# UNIT cloudstack_virtualrouter_healthcheck_lastcheck seconds\r\ncloudstack_virtualrouter_healthcheck_lastcheck{checkname=\"connectivity.test\",zone=\"zone1\",virtualrouter=\"i-123456-VM\",network=\"test-network\"} 1649228157\r\n~~~\r\n\r\nMaybe this is not 100% accurate to OpenMetrics, but I tried to follow the guidelines. Maybe somebody with more knowledge can have a look.\r\n\r\nA drawback with this solution would be that we lose information of the check result message, as Prometheus is not designed to handle this.\r\n\r\n##### ACTUAL RESULTS\r\nVirtual Router Health Checks not present on the CloudStack Prometheus metrics endpoint\r\n","comments":3,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/6212/comments","created_at":"2022-04-06T11:17:52Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/6212/events","html_url":"https://github.com/apache/cloudstack/issues/6212","id":1194459728,"labels":[{"color":"84b6eb","default":false,"description":"","id":37843366,"name":"type:enhancement","node_id":"MDU6TGFiZWwzNzg0MzM2Ng==","url":"https://api.github.com/repos/apache/cloudstack/labels/type:enhancement"},{"color":"E265FC","default":false,"description":"","id":5651870091,"name":"component:prometheus","node_id":"LA_kwDOAJTq2M8AAAABUOCxiw","url":"https://api.github.com/repos/apache/cloudstack/labels/component:prometheus"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/6212/labels{/name}","locked":false,"milestone":{"closed_issues":39,"created_at":"2026-05-08T06:15:20Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/57355700?v=4","events_url":"https://api.github.com/users/weizhouapache/events{/privacy}","followers_url":"https://api.github.com/users/weizhouapache/followers","following_url":"https://api.github.com/users/weizhouapache/following{/other_user}","gists_url":"https://api.github.com/users/weizhouapache/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/weizhouapache","id":57355700,"login":"weizhouapache","node_id":"MDQ6VXNlcjU3MzU1NzAw","organizations_url":"https://api.github.com/users/weizhouapache/orgs","received_events_url":"https://api.github.com/users/weizhouapache/received_events","repos_url":"https://api.github.com/users/weizhouapache/repos","site_admin":false,"starred_url":"https://api.github.com/users/weizhouapache/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/weizhouapache/subscriptions","type":"User","url":"https://api.github.com/users/weizhouapache"},"description":"","html_url":"https://github.com/apache/cloudstack/milestone/47","id":15843055,"labels_url":"https://api.github.com/repos/apache/cloudstack/milestones/47/labels","node_id":"MI_kwDOAJTq2M4A8b7v","number":47,"open_issues":274,"state":"open","title":"24.0","updated_at":"2026-10-02T08:13