_id\":\"MDU6TGFiZWwxMTUwNjc1NTQ5\"},{\"id\":9849008471,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/no-issue-activity\",\"name\":\"no-issue-activity\",\"color\":\"ededed\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSwvxVw\"},{\"id\":9851088157,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/long-term-plan\",\"name\":\"long-term-plan\",\"color\":\"aaaaaa\",\"description\":\"remove this label if you plan to pick up this issue.\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSyutHQ\"}],\"assignee\":{\"login\":\"winterhazel\",\"id\":25729641,\"node_id\":\"MDQ6VXNlcjI1NzI5NjQx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/25729641?v=4\",\"html_url\":\"https://github.com/winterhazel\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/winterhazel\",\"events_url\":\"https://api.github.com/users/winterhazel/events{/privacy}\",\"following_url\":\"https://api.github.com/users/winterhazel/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/winterhazel/followers\",\"gists_url\":\"https://api.github.com/users/winterhazel/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/winterhazel/orgs\",\"received_events_url\":\"https://api.github.com/users/winterhazel/received_events\",\"repos_url\":\"https://api.github.com/users/winterhazel/repos\",\"starred_url\":\"https://api.github.com/users/winterhazel/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/winterhazel/subscriptions\"},\"comments\":10,\"created_at\":\"2019-12-08T14:55:47Z\",\"updated_at\":\"2026-05-08T12:10:19Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/3751\",\"html_url\":\"https://github.com/apache/cloudstack/issues/3751\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/3751/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/3751/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/3751/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/19\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19/labels\",\"id\":6265435,\"number\":19,\"state\":\"open\",\"title\":\"unplanned\",\"creator\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":185,\"closed_issues\":1302,\"created_at\":\"2021-01-04T09:07:50Z\",\"updated_at\":\"2026-09-24T11:01:33Z\",\"node_id\":\"MDk6TWlsZXN0b25lNjI2NTQzNQ==\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/3751/reactions\"},\"assignees\":[{\"login\":\"winterhazel\",\"id\":25729641,\"node_id\":\"MDQ6VXNlcjI1NzI5NjQx\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/25729641?v=4\",\"html_url\":\"https://github.com/winterhazel\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/winterhazel\",\"events_url\":\"https://api.github.com/users/winterhazel/events{/privacy}\",\"following_url\":\"https://api.github.com/users/winterhazel/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/winterhazel/followers\",\"gists_url\":\"https://api.github.com/users/winterhazel/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/winterhazel/orgs\",\"received_events_url\":\"https://api.github.com/users/winterhazel/received_events\",\"repos_url\":\"https://api.github.com/users/winterhazel/repos\",\"starred_url\":\"https://api.github.com/users/winterhazel/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/winterhazel/subscriptions\"}],\"node_id\":\"MDU6SXNzdWU1MzQ1NTMxMjc=\",\"type\":{\"id\":93574,\"node_id\":\"IT_kwDNuP_OAAFthg\",\"name\":\"Feature\",\"description\":\"A request, idea, or new functionality\",\"color\":\"blue\",\"created_at\":\"2024-01-25T09:11:09Z\",\"updated_at\":\"2024-10-08T08:30:20Z\"}},{\"id\":714793126,\"number\":4370,\"state\":\"open\",\"state_reason\":\"reopened\",\"locked\":false,\"title\":\"more fine grained categorisation for tests\",\"body\":\"\\u003c!--\\r\\nVerify first that your issue/request is not already reported on GitHub.\\r\\nAlso test if the latest release and master branch are affected too.\\r\\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\\r\\n--\\u003e\\r\\nas a tester, one would want a more fine grained categorisation than \\\"smoke\\\", \\\"component\\\", \\\"integration\\\" to be able to quickly test a PR against features it touches on.\\r\\n\\r\\n##### ISSUE TYPE\\r\\n\\u003c!-- Pick one below and delete the rest --\\u003e\\r\\n * Improvement Request\\r\\n * Enhancement Request\\r\\n * Feature Idea\\r\\n * Other : testing aid\\r\\n\\r\\n##### COMPONENT NAME\\r\\n\\u003c!--\\r\\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\\r\\n--\\u003e\\r\\n~~~\\r\\nMarvin\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n\\u003c!--\\r\\nNew line separated list of affected versions, commit ID for issues on master branch.\\r\\n--\\u003e\\r\\n\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\n\\u003c!--\\r\\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\\r\\n--\\u003e\\r\\n\\r\\n\\r\\n##### OS / ENVIRONMENT\\r\\n\\u003c!--\\r\\nInformation about the environment if relevant, N/A otherwise\\r\\n--\\u003e\\r\\n\\r\\n\\r\\n##### SUMMARY\\r\\n\\u003c!-- Explain the problem/feature briefly --\\u003e\\r\\nwhen a PR is tested it is usually tested against a set of smoke tests in travis or a private cloud with s.moke tests and than maybe avery feature specific (often manual) test. A better categorisation would help in testing more related code and would allow for bypassing any tests that have no baring on the subject of the change.\\r\\nA blueorangutan smoke test run takes anywhere between 8 and 15 hours and fails only once after the run, albeit with multiple reports. It would be helpful to run a smaller set of basic tests. if this set passes than a more high level batch could be choosen for a next step.\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n\\u003c!--\\r\\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\\r\\n\\r\\nFor new features, show how the feature would be used.\\r\\n--\\u003e\\r\\n\\r\\n\\u003c!-- Paste example playbooks or commands between quotes below --\\u003e\\r\\n~~~\\r\\ngo-test smoke\\r\\ngo-test accounts-and-roles\\r\\ngo-test instance-groups\\r\\ngo-test ...\\r\\n~~~\\r\\n\\r\\n`go-test` could be any test infra structure like blueorangutan. It is used to illustrate the categorisation, not the test-infrastructure.\\r\\n\\r\\n\\u003c!-- You can also paste gist.github.com links for larger files --\\u003e\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\n\\u003c!-- What did you expect to happen when running the steps above? --\\u003e\\r\\n\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n\\u003c!-- What actually happened? --\\u003e\\r\\n\\r\\n\\u003c!-- Paste verbatim command output between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\",\"author_association\":\"CONTRIBUTOR\",\"user\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"labels\":[{\"id\":1663969521,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/Severity:Major\",\"name\":\"Severity:Major\",\"color\":\"903636\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwxNjYzOTY5NTIx\"},{\"id\":2510052725,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:integration-test\",\"name\":\"component:integration-test\",\"color\":\"e858a2\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwyNTEwMDUyNzI1\"},{\"id\":9839977590,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:on-hold\",\"name\":\"status:on-hold\",\"color\":\"1C6534\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSoIkdg\"},{\"id\":9851088157,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/long-term-plan\",\"name\":\"long-term-plan\",\"color\":\"aaaaaa\",\"description\":\"remove this label if you plan to pick up this issue.\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSyutHQ\"}],\"comments\":6,\"created_at\":\"2020-10-05T12:24:50Z\",\"updated_at\":\"2026-05-08T12:09:40Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/4370\",\"html_url\":\"https://github.com/apache/cloudstack/issues/4370\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/4370/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/4370/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/4370/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/19\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19/labels\",\"id\":6265435,\"number\":19,\"state\":\"open\",\"title\":\"unplanned\",\"creator\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":185,\"closed_issues\":1302,\"created_at\":\"2021-01-04T09:07:50Z\",\"updated_at\":\"2026-09-24T11:01:33Z\",\"node_id\":\"MDk6TWlsZXN0b25lNjI2NTQzNQ==\"},\"reactions\":{\"total_count\":1,\"+1\":1,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/4370/reactions\"},\"node_id\":\"MDU6SXNzdWU3MTQ3OTMxMjY=\",\"type\":{\"id\":93574,\"node_id\":\"IT_kwDNuP_OAAFthg\",\"name\":\"Feature\",\"description\":\"A request, idea, or new functionality\",\"color\":\"blue\",\"created_at\":\"2024-01-25T09:11:09Z\",\"updated_at\":\"2024-10-08T08:30:20Z\"}},{\"id\":766468471,\"number\":4542,\"state\":\"open\",\"locked\":false,\"title\":\"Reserve IP address for out of bounds machines\",\"body\":\"\\u003c!--\\r\\nVerify first that your issue/request is not already reported on GitHub.\\r\\nAlso test if the latest release and master branch are affected too.\\r\\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\\r\\n--\\u003e\\r\\nAbility to define IP address beside of choosing VMs in Static NAT, Port Forward and Load balancer services to provide those services to servers outside of CloudStack.\\r\\n##### ISSUE TYPE\\r\\n\\u003c!-- Pick one below and delete the rest --\\u003e\\r\\n * Feature Idea\\r\\n\\r\\n##### COMPONENT NAME\\r\\n\\u003c!--\\r\\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\\r\\n--\\u003e\\r\\n~~~\\r\\nVR\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n\\u003c!--\\r\\nNew line separated list of affected versions, commit ID for issues on master branch.\\r\\n--\\u003e\\r\\n\\r\\n~~~\\r\\nAll versions\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\n\\u003c!--\\r\\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\\r\\n--\\u003e\\r\\nAdvanced networking\\r\\n\\r\\n##### OS / ENVIRONMENT\\r\\n\\u003c!--\\r\\nInformation about the environment if relevant, N/A otherwise\\r\\n--\\u003e\\r\\nN/A\\r\\n\\r\\n##### SUMMARY\\r\\n\\u003c!-- Explain the problem/feature briefly --\\u003e\\r\\n\\r\\nIn some network services we need to specify which VM should use it. For example Static NAT, Port Forward and Load balancer.\\r\\nIt would be a good idea if we can also specify IP address of a server which is not managed by CloudStack.\\r\\nThis feature helps us to use network services provided by virtual router for physical servers or even VMs outside of CloudStack management area but share a common L2 network with other VMs in CloudStack.\\r\\nThis feature also requires reserve IP address capability in all type of networks. We can expand the issue #4357 for private IPs in isolated networks too.\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n\\u003c!--\\r\\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\\r\\n\\r\\nFor new features, show how the feature would be used.\\r\\n--\\u003e\\r\\n\\r\\n\\u003c!-- Paste example playbooks or commands between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\n1. Create an isolated network\\r\\n2. In Port forward section define a new rule\\r\\n3. In \\\"Add VM\\\" panel write IP address of the server outside of CloudStack\\r\\n\\r\\n~~~\\r\\n\\r\\n\\u003c!-- You can also paste gist.github.com links for larger files --\\u003e\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\n\\u003c!-- What did you expect to happen when running the steps above? --\\u003e\\r\\n\\r\\n~~~\\r\\n\\r\\nAn iptables rule created in virtual router to forward desired port to the server IP\\r\\n\\r\\n~~~\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n\\u003c!-- What actually happened? --\\u003e\\r\\n\\r\\n\\u003c!-- Paste verbatim command output between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\nIt is not possible to mention IP address of the server outside of CloudStack\\r\\n\\r\\n~~~\\r\\n\",\"author_association\":\"CONTRIBUTOR\",\"user\":{\"login\":\"aleskxyz\",\"id\":39186039,\"node_id\":\"MDQ6VXNlcjM5MTg2MDM5\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/39186039?v=4\",\"html_url\":\"https://github.com/aleskxyz\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/aleskxyz\",\"events_url\":\"https://api.github.com/users/aleskxyz/events{/privacy}\",\"following_url\":\"https://api.github.com/users/aleskxyz/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/aleskxyz/followers\",\"gists_url\":\"https://api.github.com/users/aleskxyz/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/aleskxyz/orgs\",\"received_events_url\":\"https://api.github.com/users/aleskxyz/received_events\",\"repos_url\":\"https://api.github.com/users/aleskxyz/repos\",\"starred_url\":\"https://api.github.com/users/aleskxyz/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/aleskxyz/subscriptions\"},\"labels\":[{\"id\":592559219,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:networking\",\"name\":\"component:networking\",\"color\":\"f9d0c4\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWw1OTI1NTkyMTk=\"},{\"id\":2249631279,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:experimental-feature\",\"name\":\"type:experimental-feature\",\"color\":\"c1fca4\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwyMjQ5NjMxMjc5\"},{\"id\":2531618875,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/complexity:simple\",\"name\":\"complexity:simple\",\"color\":\"000088\",\"description\":\"a few days to a couple of weeks\",\"default\":false,\"node_id\":\"MDU6TGFiZWwyNTMxNjE4ODc1\"},{\"id\":9851088157,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/long-term-plan\",\"name\":\"long-term-plan\",\"color\":\"aaaaaa\",\"description\":\"remove this label if you plan to pick up this issue.\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSyutHQ\"}],\"comments\":26,\"created_at\":\"2020-12-14T13:58:37Z\",\"updated_at\":\"2026-08-25T06:46:30Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/4542\",\"html_url\":\"https://github.com/apache/cloudstack/issues/4542\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/4542/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/4542/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/4542/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"parent_issue_url\":\"https://api.github.com/repos/apache/cloudstack/issues/9958\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/19\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19/labels\",\"id\":6265435,\"number\":19,\"state\":\"open\",\"title\":\"unplanned\",\"creator\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/Da