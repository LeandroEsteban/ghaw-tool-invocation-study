thub.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":185,\"closed_issues\":1302,\"created_at\":\"2021-01-04T09:07:50Z\",\"updated_at\":\"2026-09-24T11:01:33Z\",\"node_id\":\"MDk6TWlsZXN0b25lNjI2NTQzNQ==\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/7155/reactions\"},\"node_id\":\"I_kwDOAJTq2M5dVOLP\"},{\"id\":3782422837,\"number\":12374,\"state\":\"open\",\"locked\":false,\"title\":\"Support Debian 13 (trixie)\",\"body\":\"### The required feature described as a wish\\n\\nincludes, but not limits to\\n- debian 13 as mgmt server\\n- debian 13 as kvm host\\n- build packages for debian 13/trixie\\n- doc update on compatibility matrix\\n\\n\\n### Related issues or PRs\\nhttps://github.com/apache/cloudstack/issues/12251\\nhttps://github.com/apache/cloudstack/issues/12252\\nhttps://github.com/apache/cloudstack-documentation/pull/610\\n\",\"author_association\":\"MEMBER\",\"user\":{\"login\":\"weizhouapache\",\"id\":57355700,\"node_id\":\"MDQ6VXNlcjU3MzU1NzAw\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/57355700?v=4\",\"html_url\":\"https://github.com/weizhouapache\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/weizhouapache\",\"events_url\":\"https://api.github.com/users/weizhouapache/events{/privacy}\",\"following_url\":\"https://api.github.com/users/weizhouapache/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/weizhouapache/followers\",\"gists_url\":\"https://api.github.com/users/weizhouapache/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/weizhouapache/orgs\",\"received_events_url\":\"https://api.github.com/users/weizhouapache/received_events\",\"repos_url\":\"https://api.github.com/users/weizhouapache/repos\",\"starred_url\":\"https://api.github.com/users/weizhouapache/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/weizhouapache/subscriptions\"},\"labels\":[{\"id\":1150675549,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:new-feature\",\"name\":\"type:new-feature\",\"color\":\"4471c4\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwxMTUwNjc1NTQ5\"}],\"comments\":17,\"created_at\":\"2026-01-05T18:08:49Z\",\"updated_at\":\"2026-09-14T15:02:45Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/12374\",\"html_url\":\"https://github.com/apache/cloudstack/issues/12374\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/12374/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/12374/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/12374/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/47\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/47\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/47/labels\",\"id\":15843055,\"number\":47,\"state\":\"open\",\"title\":\"24.0\",\"description\":\"\",\"creator\":{\"login\":\"weizhouapache\",\"id\":57355700,\"node_id\":\"MDQ6VXNlcjU3MzU1NzAw\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/57355700?v=4\",\"html_url\":\"https://github.com/weizhouapache\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/weizhouapache\",\"events_url\":\"https://api.github.com/users/weizhouapache/events{/privacy}\",\"following_url\":\"https://api.github.com/users/weizhouapache/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/weizhouapache/followers\",\"gists_url\":\"https://api.github.com/users/weizhouapache/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/weizhouapache/orgs\",\"received_events_url\":\"https://api.github.com/users/weizhouapache/received_events\",\"repos_url\":\"https://api.github.com/users/weizhouapache/repos\",\"starred_url\":\"https://api.github.com/users/weizhouapache/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/weizhouapache/subscriptions\"},\"open_issues\":272,\"closed_issues\":36,\"created_at\":\"2026-05-08T06:15:20Z\",\"updated_at\":\"2026-09-29T10:27:41Z\",\"node_id\":\"MI_kwDOAJTq2M4A8b7v\"},\"reactions\":{\"total_count\":5,\"+1\":1,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":2,\"hooray\":0,\"rocket\":0,\"eyes\":2,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/12374/reactions\"},\"node_id\":\"I_kwDOAJTq2M7hczE1\",\"type\":{\"id\":93574,\"node_id\":\"IT_kwDNuP_OAAFthg\",\"name\":\"Feature\",\"description\":\"A request, idea, or new functionality\",\"color\":\"blue\",\"created_at\":\"2024-01-25T09:11:09Z\",\"updated_at\":\"2024-10-08T08:30:20Z\"}},{\"id\":1684259647,\"number\":7473,\"state\":\"open\",\"locked\":false,\"title\":\"DNS service not working for System VMs  on a fresh new install Cloudstack\",\"body\":\"\\u003c!--\\r\\nVerify first that your issue/request is not already reported on GitHub.\\r\\nAlso test if the latest release and main branch are affected too.\\r\\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\\r\\n--\\u003e\\r\\n\\r\\n##### ISSUE TYPE\\r\\n\\u003c!-- Pick one below and delete the rest --\\u003e\\r\\n * Other\\r\\n\\r\\n##### COMPONENT NAME\\r\\n\\u003c!--\\r\\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\\r\\n--\\u003e\\r\\n~~~\\r\\nUI, System VMs\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n\\u003c!--\\r\\nNew line separated list of affected versions, commit ID for issues on main branch.\\r\\n--\\u003e\\r\\n\\r\\n~~~\\r\\nCloudStack 4.18\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\n\\u003c!--\\r\\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\\r\\n--\\u003e\\r\\nZone with default Advanced networking with Isolation method as VLAN\\r\\nZone has only one \\\"Physical Network 1\\\" with  all traffic types Guest, Management, Public, Storage passing through it\\r\\nKVM\\r\\nManagement Server and KVM Host are same. Its a testing environment\\r\\nOpenVswitch and DPDK enabled and created bridge interface using OpenVswitch commands\\r\\nPrimany and Secondary with NFS mount points\\r\\n\\r\\n##### OS / ENVIRONMENT\\r\\n\\u003c!--\\r\\nInformation about the environment if relevant, N/A otherwise\\r\\n--\\u003e\\r\\nUbuntu 22.04.2 LTS\\r\\nCodename:\\tjammy\\r\\n\\r\\n##### SUMMARY\\r\\n\\u003c!-- Explain the problem/feature briefly --\\u003e\\r\\n\\r\\nThe System VMs Agent state is not Up\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n\\u003c!--\\r\\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\\r\\n\\r\\nFor new features, show how the feature would be used.\\r\\n--\\u003e\\r\\n\\r\\n\\u003c!-- Paste example playbooks or commands between quotes below --\\u003e\\r\\n~~~\\r\\nInstall a fresh new Ubuntu 22.04 LTS server \\r\\nEnable OpenVswitch and dpdk over the interface and create bridge interface\\r\\nPerform the install of cloudstack on a server. Also make this server as KVM Host.\\r\\nConfigure Cloudstack as zone with default advanced networking \\r\\nZone has only one \\\"Physical Network 1\\\" with  all traffic types Guest, Management, Public, Storage \\r\\npassing through it\\r\\n~~~\\r\\n\\r\\n\\u003c!-- You can also paste gist.github.com links for larger files --\\u003e\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\n\\u003c!-- What did you expect to happen when running the steps above? --\\u003e\\r\\n\\r\\n~~~\\r\\nThe System VMs Agent state is  OK\\r\\n~~~\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n\\u003c!-- What actually happened? --\\u003e\\r\\n\\r\\n\\u003c!-- Paste verbatim command output between quotes below --\\u003e\\r\\n~~~\\r\\nAfter the Cloudstack install and basic configuration of zone, \\r\\n\\r\\nGo system vms section, we notice the state is \\\"running\\\" but the  Agent state is not \\\"OK\\\"\\r\\n\\r\\nAccessed one of the system vm using  commands like  ssh -i /root/.ssh/id_rsa.cloud -p 3922 root@link-local \\r\\n\\r\\nIssued command /usr/local/cloud/systemvm/ssvm-check.sh\\r\\n\\r\\nNoticed error ERROR: DNS not resolving cloudstack.apache.org\\r\\n\\r\\nConfirmed Google DNS server is there at resolv.conf\\r\\n\\r\\nChecked the service cloud status and noticed the system vm can't communicate with port 8250 of management server \\r\\nover the management server IP\\r\\n\\r\\nFurther troubleshooting shows from inside system vm, only able to ping management server IP \\r\\nbut no connection with any active ports of management server like ssh port , management ports like 8250 etc\\r\\n\\r\\nWhile checking the traffic over the bridge interface using ovs-tcpdump , we have noticed the \\r\\nincoming traffic from system vms towards bridge interface are reaching but no outgoing response \\r\\ntowards system vms. Below is a sample captured traffic at bridge interface over \\r\\ncloudstack port number  8250. We believe that we setup the openvswitch dpdk setup correctly \\r\\nand not sure what we are missing from our side.\\r\\n\\r\\n12:08:52.312394 IP SVMIP.33940 \\u003e MGMTIP.8250: Flags [S], seq 3467199111, win 64240, options [mss 1460,nop,nop,sackOK,nop,wscale 7], length 0\\r\\n\\u003c.............E..4\\\\.@.@.....?...?... :..B.........................\\r\\n12:08:53.314315 IP SVMIP.33940 \\u003e MGMTIP..8250: Flags [S], seq 3467199111, win 64240, options [mss 1460,nop,nop,sackOK,nop,wscale 7], length 0\\r\\n\\r\\nissued the command \\\"ovs-ofctl dump-flows cloudbr0\\\" and got below result. Looks like the rule is fine\\r\\n\\r\\ncookie=0x0, duration=148279.131s, table=0, n_packets=7453119, n_bytes=2575374706, priority=0 actions=NORMAL\\r\\n\\r\\nNot sure what we are missing.\\r\\n\\r\\n~~~\\r\\n\",\"author_association\":\"NONE\",\"user\":{\"login\":\"bradsmin\",\"id\":131838039,\"node_id\":\"U_kgDOB9uwVw\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/131838039?v=4\",\"html_url\":\"https://github.com/bradsmin\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/bradsmin\",\"events_url\":\"https://api.github.com/users/bradsmin/events{/privacy}\",\"following_url\":\"https://api.github.com/users/bradsmin/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/bradsmin/followers\",\"gists_url\":\"https://api.github.com/users/bradsmin/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/bradsmin/orgs\",\"received_events_url\":\"https://api.github.com/users/bradsmin/received_events\",\"repos_url\":\"https://api.github.com/users/bradsmin/repos\",\"starred_url\":\"https://api.github.com/users/bradsmin/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/bradsmin/subscriptions\"},\"labels\":[{\"id\":37843368,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:question\",\"name\":\"type:question\",\"color\":\"cc317c\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwzNzg0MzM2OA==\"},{\"id\":1155016910,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:needs-reproducing\",\"name\":\"status:needs-reproducing\",\"color\":\"4e62fc\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwxMTU1MDE2OTEw\"},{\"id\":2694797573,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:needs-investigation\",\"name\":\"status:needs-investigation\",\"color\":\"906C28\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwyNjk0Nzk3NTcz\"},{\"id\":6890295339,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:stale\",\"name\":\"status:stale\",\"color\":\"E43179\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAABmrGQKw\"},{\"id\":9849008471,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/no-issue-activity\",\"name\":\"no-issue-activity\",\"color\":\"ededed\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSwvxVw\"}],\"comments\":10,\"created_at\":\"2023-04-26T04:44:30Z\",\"updated_at\":\"2026-06-06T02:17:32Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/7473\",\"html_url\":\"https://github.com/apache/cloudstack/issues/7473\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/7473/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/7473/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/7473/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/19\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19/labels\",\"id\":6265435,\"number\":19,\"state\":\"open\",\"title\":\"unplanned\",\"creator\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":185,\"closed_issues\":1302,\"created_at\":\"2021-01-04T09:07:50Z\",\"updated_at\":\"2026-09-24T11:01:33Z\",\"node_id\":\"MDk6TWlsZXN0b25lNjI2NTQzNQ==\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/7473/reactions\"},\"node_id\":\"I_kwDOAJTq2M5kY8M_\"},{\"id\":4999060061,\"number\":13735,\"state\":\"open\",\"locked\":false,\"title\":\"iptables_check.py health check deadlocks when iptables output exceeds the pipe buffer, leaking processes until the VR exhausts memory and self-reboots (~9h cycle)\",\"body\":\"##### ISSUE TYPE\\n\\n* Bug Report\\n\\n##### COMPONENT NAME\\n\\n~~~\\nSystemVM / Virtual Router health checks (systemvm/debian/root/health_checks/iptables_check.py)\\n~~~\\n\\n##### CLOUDSTACK VERSION\\n\\n~~~\\n4.22.0.0 and 4.22.1.0 (management), systemvm template 4.22.0.\\nThe affected code is unchanged on current main:\\nhttps://github.com/apache/cloudstack/blob/main/systemvm/debian/root/health_checks/iptables_check.py\\n~~~\\n\\n##### CONFIGURATION\\n\\nRedundant VPC virtual routers, KVM. Advanced zone. Default health check settings\\n(`router.health.checks.enabled=true`, `router.health.checks.advanced.interval=10`).\\nThe affected VPC has ~200 port-forwarding/LB rules (iptables-save output: 77,029 bytes).\\n\\n##### OS / ENVIRONMENT\\n\\nKVM hosts on Rocky Linux 9.5/9.8 (qemu-kvm 9.0/10.1 — reproduced on both). Debian-based\\nsystem VM template, 512 MB RAM routers.\\n\\n##### SUMMARY\\n\\n`iptables_check.py` runs the fetch command with `Popen(cmd, shell=True, stdout=PIPE)` and\\nthen calls `pout.wait()` **before** reading the pipe:\\n\\n```python\\nfetchIpTableEntriesCmd = \\\"iptables-save | grep \\\" + destIp\\npout = Popen(fetchIpTableEntriesCmd, shell=True, stdout=PIPE)\\nif pout.wait() != 0:            # \\u003c-- deadlocks: wait() before the pipe is drained\\n    ...\\nipTablesMatchingEntries = pout.communicate()[0].decode().strip().split('\\\\n')\\n```\\n\\nThis is the deadlock explicitly warned about in the Python `subprocess` documentation:\\nwhen the command's output exceeds the OS pipe capacity (64 KiB on Linux), the child\\nblocks writing to the full pipe and the parent blocks forever in `wait()`.\\n\\nOn routers with large rule sets the check therefore hangs **on every run**. Because the\\nadvanced health check fires every `router.health.checks.advanced.interval` (10 min\\ndefault), a new stuck process chain (`monitorServices.py advanced` -\\u003e `sh` -\\u003e\\n`iptables_check.py`) accumulates every interval — ~13 MB RSS each, roughly 85–90 MB/h.\\nOn a 512 MB router, RAM and swap are exhausted after ~8.5–9 h of uptime. At that point\\nkeepalived's `heartbeat` track script can no longer fork within its timeout\\n(`VRRP_Script(heartbeat) timed_out` -\\u003e `Entering FAULT STATE`), the router demotes,\\nwipes `/etc/keepalived/keepalived.conf`, and the guest reboots — taking the VPC down.\\n\\nThe impact is amplified on redundant VPCs: both routers of a pair are created together,\\nso their exhaustion clocks are synchronized and **both routers fail within minutes of\\neach other**, defeating the redundancy. We experienced a full-VPC outage roughly every\\n9 hours until the check was excluded.\\n\\n##### STEPS TO REPRODUCE\\n\\n~~~\\n1. Create a VPC with enough port-forwarding/LB rules that the health check's\\n   \\\"iptables-save | grep \\u003cip\\u003e\\\" output exceeds 64 KiB inside the router\\n   (our affected router: iptables-save = 77,029 bytes total).\\n2. Leave router.health.checks.enabled=true with default advanced interval (10 min).\\n3. Inside the router, watch: ps -eo pid,ppid,etimes,rss,args | grep -E \\\"monitorServices|iptables_check\\\"\\n4. A new stuck chain appears every 600 s and never exits (parent and child both in\\n   wchan do_wait; the shell child is blocked writing to the full pipe).\\n5. Watch \\\"free -k\\\": used memory climbs linearly; after ~8.5-9 h the router enters\\n   keepalived FAULT, demotes/wipes, and reboots.\\n~~~\\n\\nObserved accumulation (etimes exactly 600 s apart, none ever exiting):\\n\\n~~~\\n  90114   7551  /usr/bin/python /root/monitorServices.py advanced\\n  90136   7551  /bin/sh -c ./health_checks/iptables_check.py advanced\\n  90137   7551  /usr/bin/python ./health_checks/iptables_check.py advanced\\n  92506   6952  /usr/bin/python /root/monitorServices.py advanced\\n  ...     6351  (repeats every 600s)\\n  ...     5751\\n  ...     5152\\n  ...     4552\\n~~~\\n\\nControl group: three routers in other VPCs on the same platform with small rule sets\\n(iptables-save 1.2–9.3 KB) run the identical check to completion in \\u003c1 s and have\\n152-day uptimes. The only variable is iptables output size vs the 64 KiB pipe buffer.\\n\\n##### EXPECTED RESULTS\\n\\n~~~\\nThe health check completes (or fails fast) regardless of iptables rule-set size.\\n~~~\\n\\n##### ACTUAL RESULTS\\n\\n~~~\\nThe check hangs permanently on every run once the piped output exceeds 64 KiB.\\nStuck process chains accumulate every advanced-check interval until the router\\nexhausts RAM+swap (~8.5-9 h on a 512 MB router), keepalived's track script starves,\\nthe router demotes/wipes its keepalived config and reboots. Redundant pairs fail\\nnear-simultaneously because their clocks are synchronized at creation, causing a\\nrecurring full-VPC outage.\\n~~~\\n\\n##### WORKAROUND\\n\\nSet `router.health.checks.to.exclude = iptables_check.py` (global setting, dynamic).\\nNote: in our testing the value had to be the script filename **with** the `.py`\\nextension — the bare name `iptables_check` was silently ignored and the check kept\\nrunning (possibly a second, minor bug in how the exclusion list is matched).\\nAccumulated stuck processes must be killed manually inside affected routers.\\n\\n##### SUGGESTED FIX\\n\\nDo not call `wait()` while `stdout=PIPE` is unread. Use `communicate()` first and\\ncheck `returncode` afterwards, e.g.:\\n\\n```python\\npout = Popen(fetchIpTableEntriesCmd, shell=True, stdout=PIPE)\\nstdout, _ = pout.communicate()\\nif pout.returncode != 0:\\n    ...\\nipTablesMatchingEntries = stdout.decode().strip().split('\\\\n')\\n```\\n\\nThe same `Popen(stdout=PIPE)` + `wait()` pattern exists in other health check scripts\\n(e.g. `gateways_check.py`, `cpu_usage_check.py`). Their outputs are normally tiny so\\nthey do not currently hang, but they share the same latent hazard and may be worth\\nfixing in the same pass.\\n\",\"author_association\":\"NONE\",\"user\":{\"login\":\"richevanscybermyte\",\"id\":60758122,\"node_id\":\"MDQ6VXNlcjYwNzU4MTIy\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/60758122?v=4\",\"html_url\":\"https://github.com/richevanscybermyte\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/richevanscybermyte\",\"events_url\":\"https://api.github.com/users/richevanscybermyte/events{/privacy}\",\"following_url\":\"https://api.github.com/users/richevanscybermyte/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/richevanscybermyte/followers\",\"gists_url\":\"https://api.github.com/users/richevanscybermyte/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/richevanscybermyte/orgs\",\"received_events_url\":\"https://api.github.com/users/richevanscybermyte/received_events\",\"repos_url\":\"https://api.github.com/users/richevanscybermyte/repos\",\"starred_url\":\"https://api.github.com/users/richevanscybermyte/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/richevanscybermyte/subscriptions\"},\"labels\":[{\"id\":37843364,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:bug\",\"name\":\"type:bug\",\"color\":\"fc2929\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwzNzg0MzM2NA==\"},{\"id\":584073391,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:virtual-router\",\"name\":\"component:virtual-router\",\"color\":\"ffaaeb\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWw1ODQwNzMzOTE=\"},{\"id\":928084492,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/Severity:Critical\",\"name\":\"Severity:Critical\",\"color\":\"900606\",\"description\":\"Critical bug\",\"default\":false,\"node_id\":\"MDU6TGFiZWw5MjgwODQ0OTI=\"}],\"comments\":3,\"created_at\":\"2026-07-28T13:25:58Z\",\"updated_at\":\"2026-08-20T13:47:59Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/13735\",\"html_url\":\"https://github.com/apache/cloudstack/issues/13735\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/13735/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/13735/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/13735/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/46\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/46\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/46/labels\",\"id\":15514689,\"number\":46,\"state\":\"open\",\"title\":\"4.22.2\",\"description\":\"\",\"creator\":{\"login\":\"sureshanaparti\",\"id\":12028987,\"node_id\":\"MDQ6VXNlcjEyMDI4OTg3\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/12028987?v=4\",\"html_url\":\"https://github.com/sureshanaparti\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/sureshanaparti\",\"events_url\":\"https://api.github.com/users/sureshanaparti/events{/privacy}\",\"following_url\":\"https://api.github.com/users/sureshanaparti/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/sureshanaparti/followers\",\"gists_url\":\"https://api.github.com/users/sureshanaparti/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/sureshanaparti/orgs\",\"received_events_url\":\"https://api.github.com/users/sureshanaparti/received_events\",\"repos_url\":\"https://api.github.com/users/sureshanaparti/repos\",\"starred_url\":\"https://api.github.com/users/sureshanaparti/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/sureshanaparti/subscriptions\"},\"open_issues\":252,\"closed_issues\":114,\"created_at\":\"2026-04-13T07:02:43Z\",\"updated_at\":\"2026-09-29T13:13:59Z\",\"node_id\":\"MI_kwDOAJTq2M4A7LxB\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/13735/reactions\"},\"node_id\":\"I_kwDOAJTq2M8AAAABKfeaXQ\"},{\"id\":1236842567,\"number\":6391,\"state\":\"open\",\"locked\":false,\"title\":\"Py3 component tests fixes\",\"body\":\"\\u003c!--\\r\\nVerify first that your issue/request is not already reported on GitHub.\\r\\nAlso test if the latest release and main branch are affected too.\\r\\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\\r\\n--\\u003e\\r\\n\\r\\n##### ISSUE TYPE\\r\\n\\u003c!-- Pick one below and delete the rest --\\u003e\\r\\n * Improvement Request\\r\\n\\r\\n##### COMPONENT NAME\\r\\n\\u003c!--\\r\\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\\r\\n--\\u003e\\r\\n~~~\\r\\nComponent tests\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n\\u003c!--\\r\\nNew line separated list of affected versions, commit ID for issues on main branch.\\r\\n--\\u003e\\r\\n\\r\\n~~~\\r\\n4.16+\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\n\\u003c!--\\r\\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\\r\\n--\\u003e\\r\\nNA\\r\\n\\r\\n##### OS / ENVIRONMENT\\r\\n\\u003c!--\\r\\nInformation about the environment if relevant, N/A otherwise\\r\\n--\\u003e\\r\\nNA\\r\\n\\r\\n##### SUMMARY\\r\\n\\u003c!-- Explain the problem/feature briefly --\\u003e\\r\\nthe component tests have been ported to python3 but a lot of them are non functional. In #5442 a start was made but this is going to require more work than should be stuffed in a single PR. Below is a list of the component test that need looking at. Some can be assessed and disgarded. Others should be fixed.\\r\\n\\r\\n- [ ] test_add_remove_network.py\\r\\n- [ ] test_affinity_groups_projects.py\\r\\n- [ ] test_affinity_groups.py\\r\\n- [ ] test_base_image_updation.py\\r\\n- [ ] test_blocker_bugs.py\\r\\n- [ ] test_browse_templates.py\\r\\n- [ ] test_browse_volumes.py\\r\\n- [ ] test_bugs.py\\r\\n- [ ] test_configdrive.py\\r\\n- [ ] test_dedicate_guest_vlan_ranges.py\\r\\n- [ ] test_dedicate_public_ip_range.py\\r\\n- [ ] test_dhcp_dns_offload.py\\r\\n- [ ] test_egress_fw_rules.py\\r\\n- [ ] test_escalation_listTemplateDomainAdmin.py\\r\\n- [ ] test_escalations_hosts.py\\r\\n- [ ] test_escalations_ipaddresses.py\\r\\n- [ ] test_escalations_networks.py\\r\\n- [ ] test_escalations_volumes.py\\r\\n- [ ] test_escalations_vpncustomergateways.py\\r\\n- [ ] test_escalation_templates.py\\r\\n- [ ] test_explicit_dedication.py\\r\\n- [ ] test_ha_pool_maintenance.py\\r\\n- [ ] test_high_availability.py\\r\\n- [ ] test_implicit_planner.py\\r\\n- [ ] test_ip_resource_count_for_vpc.py\\r\\n- [ ] test_multiple_public_interfaces.py\\r\\n- [ ] test_organization_states.py\\r\\n- [ ] test_persistent_networks.py\\r\\n- [ ] test_portable_ip.py\\r\\n- [ ] test_ps_resource_limits_volume.py\\r\\n- [ ] test_redundant_router_cleanups.py\\r\\n- [ ] test_redundant_router_deployment_planning.py\\r\\n- [ ] test_redundant_router_network_rules.py\\r\\n- [ ] test_redundant_router.py\\r\\n- [ ] test_reset_ssh_keypair.py\\r\\n- [ ] test_rootvolume_resize.py\\r\\n- [ ] test_shared_networks.py\\r\\n- [ ] test_snapshots.py\\r\\n- [ ] test_ss_limits.py\\r\\n- [ ] test_ss_max_limits.py\\r\\n- [ ] test_ss_project_limits.py\\r\\n- [ ] test_stopped_vm.py\\r\\n- [ ] test_storage_motion.py\\r\\n- [ ] test_tags.py\\r\\n- [ ] test_volumes.py\\r\\n- [ ] test_vpc_host_maintenance.py\\r\\n- [ ] test_vpc_network_internal_lbrules.py\\r\\n- [ ] test_vpc_network_pfrules.py\\r\\n- [ ] test_vpc_network.py\\r\\n- [ ] test_vpc_network_staticnatrule.py\\r\\n- [ ] test_vpc_offerings.py\\r\\n- [ ] test_vpc_routers.py\\r\\n- [ ] test_vpc_vm_life_cycle.py\\r\\n- [ ] test_vpc_vms_deployment.py\\r\\n- [ ] test_vpn_service.py\\r\\n- [ ] test_vpn_users.py\\r\\n- [ ] test_vr_metadata.py\\r\\n- [ ] test_zone_level_local_storage_setting.py\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n\\u003c!--\\r\\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\\r\\n\\r\\nFor new features, show how the feature would be used.\\r\\n--\\u003e\\r\\n\\r\\n\\u003c!-- Paste example playbooks or commands between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n\\u003c!-- You can also paste gist.github.com links for larger files --\\u003e\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\n\\u003c!-- What did you expect to happen when running the steps above? --\\u003e\\r\\n\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n\\u003c!-- What actually happened? --\\u003e\\r\\n\\r\\n\\u003c!-- Paste verbatim command output between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\",\"author_association\":\"CONTRIBUTOR\",\"user\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\