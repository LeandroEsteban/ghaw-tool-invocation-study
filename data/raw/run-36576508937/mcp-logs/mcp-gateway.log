/45762285?v=4","events_url":"https://api.github.com/users/andrijapanicsb/events{/privacy}","followers_url":"https://api.github.com/users/andrijapanicsb/followers","following_url":"https://api.github.com/users/andrijapanicsb/following{/other_user}","gists_url":"https://api.github.com/users/andrijapanicsb/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/andrijapanicsb","id":45762285,"login":"andrijapanicsb","node_id":"MDQ6VXNlcjQ1NzYyMjg1","organizations_url":"https://api.github.com/users/andrijapanicsb/orgs","received_events_url":"https://api.github.com/users/andrijapanicsb/received_events","repos_url":"https://api.github.com/users/andrijapanicsb/repos","site_admin":false,"starred_url":"https://api.github.com/users/andrijapanicsb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/andrijapanicsb/subscriptions","type":"User","url":"https://api.github.com/users/andrijapanicsb"}},{"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/12028987?v=4","events_url":"https://api.github.com/users/sureshanaparti/events{/privacy}","followers_url":"https://api.github.com/users/sureshanaparti/followers","following_url":"https://api.github.com/users/sureshanaparti/following{/other_user}","gists_url":"https://api.github.com/users/sureshanaparti/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/sureshanaparti","id":12028987,"login":"sureshanaparti","node_id":"MDQ6VXNlcjEyMDI4OTg3","organizations_url":"https://api.github.com/users/sureshanaparti/orgs","received_events_url":"https://api.github.com/users/sureshanaparti/received_events","repos_url":"https://api.github.com/users/sureshanaparti/repos","site_admin":false,"starred_url":"https://api.github.com/users/sureshanaparti/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sureshanaparti/subscriptions","type":"User","url":"https://api.github.com/users/sureshanaparti"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/12028987?v=4","events_url":"https://api.github.com/users/sureshanaparti/events{/privacy}","followers_url":"https://api.github.com/users/sureshanaparti/followers","following_url":"https://api.github.com/users/sureshanaparti/following{/other_user}","gists_url":"https://api.github.com/users/sureshanaparti/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/sureshanaparti","id":12028987,"login":"sureshanaparti","node_id":"MDQ6VXNlcjEyMDI4OTg3","organizations_url":"https://api.github.com/users/sureshanaparti/orgs","received_events_url":"https://api.github.com/users/sureshanaparti/received_events","repos_url":"https://api.github.com/users/sureshanaparti/repos","site_admin":false,"starred_url":"https://api.github.com/users/sureshanaparti/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sureshanaparti/subscriptions","type":"User","url":"https://api.github.com/users/sureshanaparti"}],"author_association":"CONTRIBUTOR","body":"### problem\n\nWindows guest instances (Virtual Desktops) do not find any Audio hardware.\n\n\u003cimg width=\"351\" height=\"158\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/350cc7cf-e758-497e-8615-c0851773fd17\" /\u003e\n\nBy adding `sound` to the global setting `allow.additional.vm.configuration.list.kvm`...\n\n\u003cimg width=\"1390\" height=\"124\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f7430d0d-d65f-4719-8ab4-c69579b7af11\" /\u003e\n\n...CloudMonkey can add this `extraconfig`.\n\n\u003cimg width=\"1009\" height=\"106\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/2eeb6821-69ed-4b9c-b5e7-fbeeb37aba95\" /\u003e\n\n\u003cimg width=\"515\" height=\"436\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a1f42fad-9a33-46db-b6c5-bb2237693cf5\" /\u003e\n\nThen, after power cycling the VM, the issue is resolved.\n\n\u003cimg width=\"254\" height=\"121\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/606a92e2-3a94-43c2-a3d4-2c7d9e858f9a\" /\u003e\n\nIt does not feel like a feature request, but a \"bug\" to the default global settings.","comments":8,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/12889/comments","created_at":"2026-03-25T16:35:42Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/12889/events","html_url":"https://github.com/apache/cloudstack/issues/12889","id":4136813241,"labels":[{"color":"84b6eb","default":false,"description":"","id":37843366,"name":"type:enhancement","node_id":"MDU6TGFiZWwzNzg0MzM2Ng==","url":"https://api.github.com/repos/apache/cloudstack/labels/type:enhancement"},{"color":"006b75","default":false,"description":"","id":584072971,"name":"component:kvm","node_id":"MDU6TGFiZWw1ODQwNzI5NzE=","url":"https://api.github.com/repos/apache/cloudstack/labels/component:kvm"},{"color":"ea62a8","default":false,"description":"","id":739374767,"name":"component:UI","node_id":"MDU6TGFiZWw3MzkzNzQ3Njc=","url":"https://api.github.com/repos/apache/cloudstack/labels/component:UI"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/12889/labels{/name}","locked":false,"milestone":{"closed_issues":79,"created_at":"2026-01-21T11:18:05Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/2486961?v=4","events_url":"https://api.github.com/users/DaanHoogland/events{/privacy}","followers_url":"https://api.github.com/users/DaanHoogland/followers","following_url":"https://api.github.com/users/DaanHoogland/following{/other_user}","gists_url":"https://api.github.com/users/DaanHoogland/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/DaanHoogland","id":2486961,"login":"DaanHoogland","node_id":"MDQ6VXNlcjI0ODY5NjE=","organizations_url":"https://api.github.com/users/DaanHoogland/orgs","received_events_url":"https://api.github.com/users/DaanHoogland/received_events","repos_url":"https://api.github.com/users/DaanHoogland/repos","site_admin":false,"starred_url":"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DaanHoogland/subscriptions","type":"User","url":"https://api.github.com/users/DaanHoogland"},"html_url":"https://github.com/apache/cloudstack/milestone/45","id":14595362,"labels_url":"https://api.github.com/repos/apache/cloudstack/milestones/45/labels","node_id":"MI_kwDOAJTq2M4A3rUi","number":45,"open_issues":135,"state":"open","title":"4.20.4","updated_at":"2026-09-15T19:56:19Z","url":"https://api.github.com/repos/apache/cloudstack/milestones/45"},"node_id":"I_kwDOAJTq2M72ksK5","number":12889,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/apache/cloudstack/issues/12889/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","title":"Windows Guest Instances Have No Sound","updated_at":"2026-08-14T14:00:22Z","url":"https://api.github.com/repos/apache/cloudstack/issues/12889","user":{"avatar_url":"https://avatars.githubusercontent.com/u/90287660?v=4","events_url":"https://api.github.com/users/daviftorres/events{/privacy}","followers_url":"https://api.github.com/users/daviftorres/followers","following_url":"https://api.github.com/users/daviftorres/following{/other_user}","gists_url":"https://api.github.com/users/daviftorres/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/daviftorres","id":90287660,"login":"daviftorres","node_id":"MDQ6VXNlcjkwMjg3NjYw","organizations_url":"https://api.github.com/users/daviftorres/orgs","received_events_url":"https://api.github.com/users/daviftorres/received_events","repos_url":"https://api.github.com/users/daviftorres/repos","site_admin":false,"starred_url":"https://api.github.com/users/daviftorres/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/daviftorres/subscriptions","type":"User","url":"https://api.github.com/users/daviftorres"}},{"author_association":"NONE","body":"### problem\n\n## Description\nWhen restoring a volume from backup and attaching it to a **running** KVM VM, the volume is only attached at the **database level** but not actually hot-attached to the running VM via libvirt. This means:\n1. The volume appears in CloudStack UI as \"attached\"\n2. The volume does NOT appear in `virsh domblklist \u003cvm-name\u003e` \n3. The volume is NOT visible inside the guest OS\n4. User must reboot(forced) the VM to see the restored volume\n## Root Cause\nIn `KVMGuru.attachRestoredVolumeToVirtualMachine()` (line 380-400), the method only:\n- Updates the volume state in the database via `_volumeDao.attachVolume()`\n- Sets volume state to `Ready`\nIt does **NOT**:\n- Check if VM is running\n- Send an `AttachCommand` to the KVM agent to hot-attach the disk via libvirt\n## Expected Behavior\nWhen attaching a restored volume to a **running** VM:\n1. CloudStack should detect the VM state\n2. If VM is [Running](cci:1://file:///root/new_merge/olympos-cloud-platform/plugins/hypervisors/kvm/src/main/java/com/cloud/hypervisor/kvm/resource/LibvirtComputingResource.java:5982:4-5991:5), send a libvirt attach command to hot-attach the disk\n3. Volume should immediately appear in `virsh domblklist` and inside guest OS\n4. No reboot should be required\n\n### versions\n\nCloudStack: 4.21.0\nHypervisor: KVM\nHost OS: Rocky Linux 9\nGuest OS: Rocky Linux 9 / Windows 10 - 2022 Server\n\n\n### The steps to reproduce the bug\n\n## Steps to Reproduce\n1. Create a VM with a data disk\n2. Create a backup of the VM\n3. Start the VM (ensure it's running)\n4. Restore the backed-up volume and attach to the running VM via API:\n   `restoreVolumeFromBackupAndAttachToVM`\n5. Check `virsh domblklist \u003cvm-name\u003e` on the KVM host\n6. **Observe:** The restored volume is NOT listed\n7. Check inside guest OS\n8. **Observe:** The disk is NOT visible\n9. Reboot(forced) the VM\n10. **Observe:** After reboot(forced), the disk appears\n\n### What to do about it?\n\nEither:\nA) Add hot-attach logic to `KVMGuru.attachRestoredVolumeToVirtualMachine()` to send `AttachCommand` when VM is running\nB) Or document this as expected behavior and require users to stop VM before restoring volumes\nOption A is preferred as it aligns with how regular [attachVolume](cci:1://file:///root/new_merge/olympos-cloud-platform/server/src/main/java/com/cloud/storage/VolumeApiServiceImpl.java:2479:4-2483:5) API works for running VMs.","comments":3,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/12405/comments","created_at":"2026-01-12T11:28:53Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/12405/events","html_url":"https://github.com/apache/cloudstack/issues/12405","id":3803910012,"labels":[{"color":"4e62fc","default":false,"description":"","id":1155016910,"name":"status:needs-reproducing","node_id":"MDU6TGFiZWwxMTU1MDE2OTEw","url":"https://api.github.com/repos/apache/cloudstack/labels/status:needs-reproducing"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/12405/labels{/name}","locked":false,"milestone":{"closed_issues":114,"created_at":"2026-04-13T07:02:43Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/12028987?v=4","events_url":"https://api.github.com/users/sureshanaparti/events{/privacy}","followers_url":"https://api.github.com/users/sureshanaparti/followers","following_url":"https://api.github.com/users/sureshanaparti/following{/other_user}","gists_url":"https://api.github.com/users/sureshanaparti/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/sureshanaparti","id":12028987,"login":"sureshanaparti","node_id":"MDQ6VXNlcjEyMDI4OTg3","organizations_url":"https://api.github.com/users/sureshanaparti/orgs","received_events_url":"https://api.github.com/users/sureshanaparti/received_events","repos_url":"https://api.github.com/users/sureshanaparti/repos","site_admin":false,"starred_url":"https://api.github.com/users/sureshanaparti/starred{/owner}{/repo}","subscriptions_url":"https://api.