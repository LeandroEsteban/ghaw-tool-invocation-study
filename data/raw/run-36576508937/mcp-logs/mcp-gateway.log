\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/13435/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/13435/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/13435/reactions\"},\"node_id\":\"I_kwDOAJTq2M8AAAABFs7vPw\"}]}","type":"text"}]}}
