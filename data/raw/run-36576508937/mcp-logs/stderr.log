guard:wasm label_response input JSON (2720 bytes): {"capabilities":{},"tool_args":{"order":"asc","perPage":30,"query":"repo:apache/cloudstack is:issue is:open no:label","sort":"created"},"tool_name":"search_issues","tool_result":{"content":[{"text":"{\"total_count\":1,\"incomplete_results\":false,\"items\":[{\"id\":5630698507,\"number\":14265,\"state\":\"open\",\"locked\":false,\"title\":\"[Feature] Add latest OS versions to guest OS list\",\"body\":\"### The required feature described as a wish\\n\\nAs an MSP switching from vmware to cloudstack at the moment we would love to see the latest Linux versions within the Guest OS list by default. Currently Alma/Rocky etc. are on version 9, debian latest is 12, ubuntu latest is 24. All of them have one newer Major version not sure about other distributions.\\n\\nI know we can add all these manual. But would be nice to have them in the default to have no issues wit future cloudstack updates.\",\"author_association\":\"NONE\",\"user\":{\"login\":\"la-wu\",\"id\":295070573,\"node_id\":\"U_kgDOEZZrbQ\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/295070573?v=4\",\"html_url\":\"https://github.com/la-wu\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/la-wu\",\"events_url\":\"https://api.github.com/users/la-wu/events{/privacy}\",\"following_url\":\"https://api.github.com/users/la-wu/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/la-wu/followers\",\"gists_url\":\"https://api.github.com/users/la-wu/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/la-wu/orgs\",\"received_events_url\":\"https://api.github.com/users/la-wu/received_events\",\"repos_url\":\"https://api.github.com/users/la-wu/repos\",\"starred_url\":\"https://api.github.com/users/la-wu/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/la-wu/subscriptions\"},\"comments\":0,\"created_at\":\"2026-09-29T12:39:54Z\",\"updated_at\":\"20