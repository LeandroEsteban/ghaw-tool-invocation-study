D RESULTS\\r\\n\\u003c!-- What did you expect to happen when running the steps above? --\\u003e\\r\\n\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n\\u003c!-- What actually happened? --\\u003e\\r\\n\\r\\n\\u003c!-- Paste verbatim command output between quotes below --\\u003e\\r\\n~~~\\r\\nDeploy Kubernetes cluster in L2 network with VNF\\r\\n~~~\\r\\n\",\"author_association\":\"NONE\",\"user\":{\"login\":\"leduyquy\",\"id\":68555139,\"node_id\":\"MDQ6VXNlcjY4NTU1MTM5\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/68555139?v=4\",\"html_url\":\"https://github.com/leduyquy\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/leduyquy\",\"events_url\":\"https://api.github.com/users/leduyquy/events{/privacy}\",\"following_url\":\"https://api.github.com/users/leduyquy/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/leduyquy/followers\",\"gists_url\":\"https://api.github.com/users/leduyquy/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/leduyquy/orgs\",\"received_events_url\":\"https://api.github.com/users/leduyquy/received_events\",\"repos_url\":\"https://api.github.com/users/leduyquy/repos\",\"starred_url\":\"https://api.github.com/users/leduyquy/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/leduyquy/subscriptions\"},\"labels\":[{\"id\":37843366,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:enhancement\",\"name\":\"type:enhancement\",\"color\":\"84b6eb\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwzNzg0MzM2Ng==\"},{\"id\":37843368,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:question\",\"name\":\"type:question\",\"color\":\"cc317c\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwzNzg0MzM2OA==\"},{\"id\":5650616953,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/has-3rdparty-components\",\"name\":\"has-3rdparty-component