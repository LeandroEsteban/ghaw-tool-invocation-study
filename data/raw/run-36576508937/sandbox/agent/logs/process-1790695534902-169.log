rs/weizhouapache/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/weizhouapache/subscriptions","type":"User","url":"https://api.github.com/users/weizhouapache"},"description":"","html_url":"https://github.com/apache/cloudstack/milestone/47","id":15843055,"labels_url":"https://api.github.com/repos/apache/cloudstack/milestones/47/labels","node_id":"MI_kwDOAJTq2M4A8b7v","number":47,"open_issues":272,"state":"open","title":"24.0","updated_at":"2026-09-29T10:27:41Z","url":"https://api.github.com/repos/apache/cloudstack/milestones/47"},"node_id":"I_kwDOAJTq2M54wE56","number":8304,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/apache/cloudstack/issues/8304/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","title":"Request to improve updateNetwork api ","type":{"color":"blue","created_at":"2024-01-25T09:11:09Z","description":"A request, idea, or new functionality","id":93574,"name":"Feature","node_id":"IT_kwDNuP_OAAFthg","updated_at":"2024-10-08T08:30:20Z"},"updated_at":"2026-06-29T08:12:58Z","url":"https://api.github.com/repos/apache/cloudstack/issues/8304","user":{"avatar_url":"https://avatars.githubusercontent.com/u/3714094?v=4","events_url":"https://api.github.com/users/0sorkon/events{/privacy}","followers_url":"https://api.github.com/users/0sorkon/followers","following_url":"https://api.github.com/users/0sorkon/following{/other_user}","gists_url":"https://api.github.com/users/0sorkon/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/0sorkon","id":3714094,"login":"0sorkon","node_id":"MDQ6VXNlcjM3MTQwOTQ=","organizations_url":"https://api.github.com/users/0sorkon/orgs","received_events_url":"https://api.github.com/users/0sorkon/received_events","repos_url":"https://api.github.com/users/0sorkon/repos","site_admin":false,"starred_url":"https://api.github.com/users/0sorkon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/0sorkon/subscriptions","type":"User","url":"https://api.github.com/users/0sorkon"}},{"author_association":"CONTRIBUTOR","body":"### problem\n\nWhen multiple network tiers are brought up in quick succession in a redundant VPC, I can consistently reproduce both VPCs going primary.\n\nThis is really bad because the VIP is then owned by both Virtual Routers and it means traffic is getting dropped like crazy, it makes the entire VPC unusable.  Restarting the VPC recovers it to a good state.\n\nPlease see the comments for debugging information, but in short it appears at least one of the nodes ends up getting munged address information which causes the wrong ips to be programmed on interfaces and the keepalived configs to diverge between nodes which causes the dual primary.  The underlying cause of the issue is this munged address information.\n\n### versions\n\n4.21.0\n\n### The steps to reproduce the bug\n\nUse Terraform to create the VPC, network tiers, and VM Instances.\nTerraform configuration being used is here: https://github.com/bradh352/terraform-config\n\n\n### What to do about it?\n\n_No response_","comments":23,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/11710/comments","created_at":"2025-09-24T13:00:55Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/11710/events","html_url":"https://github.com/apache/cloudstack/issues/11710","id":3449343635,"labels":[{"color":"ffaaeb","default":false,"description":"","id":584073391,"name":"component:virtual-router","node_id":"MDU6TGFiZWw1ODQwNzMzOTE=","url":"https://api.github.com/repos/apache/cloudstack/labels/component:virtual-router"},{"color":"906C28","default":false,"description":"","id":2694797573,"name":"status:needs-investigation","node_id":"MDU6TGFiZWwyNjk0Nzk3NTcz","url":"https://api.github.com/repos/apache/cloudstack/labels/status:needs-investigation"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/11710/labels{/name}","locked":false,"milestone":{"closed_issues":114,"created_at":"2026-04-13T07:02:43Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/12028987?v=4","events_url":"https://api.github.com/users/sureshanaparti/events{/privacy}","followers_url":"https://api.github.com/users/sureshanaparti/followers","following_url":"https://api.github.com/users/sureshanaparti/following{/other_user}","gists_url":"https://api.github.com/users/sureshanaparti/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/sureshanaparti","id":12028987,"login":"sureshanaparti","node_id":"MDQ6VXNlcjEyMDI4OTg3","organizations_url":"https://api.github.com/users/sureshanaparti/orgs","received_events_url":"https://api.github.com/users/sureshanaparti/received_events","repos_url":"https://api.github.com/users/sureshanaparti/repos","site_admin":false,"starred_url":"https://api.github.com/users/sureshanaparti/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sureshanaparti/subscriptions","type":"User","url":"https://api.github.com/users/sureshanaparti"},"description":"","html_url":"https://github.com/apache/cloudstack/milestone/46","id":15514689,"labels_url":"https://api.github.com/repos/apache/cloudstack/milestones/46/labels","node_id":"MI_kwDOAJTq2M4A7LxB","number":46,"open_issues":252,"state":"open","title":"4.22.2","updated_at":"2026-09-29T13:13:59Z","url":"https://api.github.com/repos/apache/cloudstack/milestones/46"},"node_id":"I_kwDOAJTq2M7NmM6T","number":11710,"reactions":{"+1":1,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":1,"url":"https://api.github.com/repos/apache/cloudstack/issues/11710/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","title":"Redundant VPC VR goes dual PRIMARY (race condition?)","type":{"color":"red","created_at":"2024-01-25T09:11:09Z","description":"An unexpected problem or behavior","id":93570,"name":"Bug","node_id":"IT_kwDNuP_OAAFtgg","updated_at":"2024-07-26T10:04:57Z"},"updated_at":"2026-09-10T19:50:35Z","url":"https://api.github.com/repos/apache/cloudstack/issues/11710","user":{"avatar_url":"https://avatars.githubusercontent.com/u/19732188?v=4","events_url":"https://api.github.com/users/bradh352/events{/privacy}","followers_url":"https://api.github.com/users/bradh352/followers","following_url":"https://api.github.com/users/bradh352/following{/other_user}","gists_url":"https://api.github.com/users/bradh352/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/bradh352","id":19732188,"login":"bradh352","node_id":"MDQ6VXNlcjE5NzMyMTg4","organizations_url":"https://api.github.com/users/bradh352/orgs","received_events_url":"https://api.github.com/users/bradh352/received_events","repos_url":"https://api.github.com/users/bradh352/repos","site_admin":false,"starred_url":"https://api.github.com/users/bradh352/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradh352/subscriptions","type":"User","url":"https://api.github.com/users/bradh352"}},{"author_association":"NONE","body":"### problem\n\nWe did some manual, routing corrections as a work around but want to know if this is a Bug.\n!\nI have the management on a vxlan, but when creating the Zone the system adds the IPs to a VLAN://untagged. that VLAN is for public.\n!\nThere is no way for me to move them to VXLAN the Management:\n!\n!\n!\nThe Management Interface was created during the Installation: But was loaded to a vlan://untagged - I do not have how as I specifically set for vxlan on cloudbr1\n!\n\n<img width=\"776\" height=\"388\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d297ee4d-6b14-4ddb-82c2-2fe4e1005a59\" />\n!\n!\n!\nThe Zone Has VXLANs for Primary storage, Management, and Guest.\n!\n\n<img width=\"610\" height=\"412\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a2115ea3-f395-4076-a4fd-69d1f9eb970c\" />\n!\n!\n<img width=\"786\" height=\"401\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/6ea626b2-9106-4ae6-ad3d-f368b7a70ea6\" />\n!\n!\n!\nAny Attemp to change the VLAN to VXLAN results on an error:\n!\n\n<img width=\"318\" height=\"94\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/4adc2cab-aa97-4de4-b951-ff83360e7ef4\" />\n!\n!\n! Additionally The Secondary Storage is affected by this routing.\n!\n!\nIs the Storage Traffic type solely for Primary storage ? I will like to have the secondary storage on a separate routed or L2/Vlan tagged\nOur primary Storage is CEPH running on VXLAN and have no problems at all - Primary storage and Guest VXLAN are the only thing working as it should per the documentation.\n!\n!\n\n<img width=\"612\" height=\"350\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/7d4acb42-b211-4b83-8f8a-e7fbb016c0f9\" />\n\n\n\n### versions\n\nCS 4.20.1\nPRI STORAGE:   CEPH\nSEC STORAGE: NFS EMC\nVXLAN\nForced VLAN for Public - but System auto-configures the Management on vlan://untagged which also uses Secondary Storage.\n\n### The steps to reproduce the bug\n\n1. Create a new Zone, all new systems.\n2. put on vxlan management, secondary-storage and guest on cloudbr1\n3. pod settings: Assign the IP range for management - there is nowhere to add a VXLAN ports for Management during the initial setup/configuration\n4. System VM proxy have to be routed manually, same as Secondary storage.\n\n\nNot possible to set secondary storage using routing without VRFs, as systemVM automatically try to push it over VLAN://untagged being forced to manually route over vlan://untagged...\n\nAs a workaround we route sec Storage and Management over vlan://untagged\n\n### What to do about it?\n\nThe management should use the vxlan://assigend, and secondary storage should be able to have its own route if needed.\nThe UI configures the Storage for the primary Storage only.\n","comments":11,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/11983/comments","