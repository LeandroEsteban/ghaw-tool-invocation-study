ut between quotes below -->\r\n~~~\r\nDeploy Kubernetes cluster in L2 network with VNF\r\n~~~\r\n","comments":2,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/9403/comments","created_at":"2024-07-17T03:12:09Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/9403/events","html_url":"https://github.com/apache/cloudstack/issues/9403","id":2412536904,"labels":[{"color":"84b6eb","default":false,"description":"","id":37843366,"name":"type:enhancement","node_id":"MDU6TGFiZWwzNzg0MzM2Ng==","url":"https://api.github.com/repos/apache/cloudstack/labels/type:enhancement"},{"color":"cc317c","default":false,"description":"","id":37843368,"name":"type:question","node_id":"MDU6TGFiZWwzNzg0MzM2OA==","url":"https://api.github.com/repos/apache/cloudstack/labels/type:question"},{"color":"8AD653","default":false,"description":"","id":5650616953,"name":"has-3rdparty-components","node_id":"LA_kwDOAJTq2M8AAAABUM2SeQ","url":"https://api.github.com/repos/apache/cloudstack/labels/has-3rdparty-components"},{"color":"ededed","default":false,"id":10096230668,"name":"archive","node_id":"LA_kwDOAJTq2M8AAAACWchBDA","url":"https://api.github.com/repos/apache/cloudstack/labels/archive"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/9403/labels{/name}","locked":false,"milestone":{"closed_issues":1302,"created_at":"2021-01-04T09:07:50Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/2486961?v=4","events_url":"https://api.github.com/users/DaanHoogland/events{/privacy}","followers_url":"https://api.github.com/users/DaanHoogland/followers","following_url":"https://api.github.com/users/DaanHoogland/following{/other_user}","gists_url":"https://api.github.com/users/DaanHoogland/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/DaanHoogland","id":2486961,"login":"DaanHoogland","node_id":"MDQ6VXNlcjI0ODY5NjE=","organizations_url":"https://api.github.com/users/DaanHoogland/orgs","received_events_url":"https://api.