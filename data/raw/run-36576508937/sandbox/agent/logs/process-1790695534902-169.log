":"https://api.github.com/users/DaanHoogland/following{/other_user}","gists_url":"https://api.github.com/users/DaanHoogland/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/DaanHoogland","id":2486961,"login":"DaanHoogland","node_id":"MDQ6VXNlcjI0ODY5NjE=","organizations_url":"https://api.github.com/users/DaanHoogland/orgs","received_events_url":"https://api.github.com/users/DaanHoogland/received_events","repos_url":"https://api.github.com/users/DaanHoogland/repos","site_admin":false,"starred_url":"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DaanHoogland/subscriptions","type":"User","url":"https://api.github.com/users/DaanHoogland"}},{"author_association":"MEMBER","body":"### The required feature described as a wish\n\nincludes, but not limits to\n- debian 13 as mgmt server\n- debian 13 as kvm host\n- build packages for debian 13/trixie\n- doc update on compatibility matrix\n\n\n### Related issues or PRs\nhttps://github.com/apache/cloudstack/issues/12251\nhttps://github.com/apache/cloudstack/issues/12252\nhttps://github.com/apache/cloudstack-documentation/pull/610\n","comments":17,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/12374/comments","created_at":"2026-01-05T18:08:49Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/12374/events","html_url":"https://github.com/apache/cloudstack/issues/12374","id":3782422837,"labels":[{"color":"4471c4","default":false,"description":"","id":1150675549,"name":"type:new-feature","node_id":"MDU6TGFiZWwxMTUwNjc1NTQ5","url":"https://api.github.com/repos/apache/cloudstack/labels/type:new-feature"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/12374/labels{/name}","locked":false,"milestone":{"closed_issues":36,"created_at":"2026-05-08T06:15:20Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/57355700?v=4","events_url":"https://api.github.com/users/weizhouapache/events{/privacy}","followers_url":"https://api.github.com/users/weizhouapache/followers","following_url":"https://api.github.com/users/weizhouapache/following{/other_user}","gists_url":"https://api.github.com/users/weizhouapache/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/weizhouapache","id":57355700,"login":"weizhouapache","node_id":"MDQ6VXNlcjU3MzU1NzAw","organizations_url":"https://api.github.com/users/weizhouapache/orgs","received_events_url":"https://api.github.com/users/weizhouapache/received_events","repos_url":"https://api.github.com/users/weizhouapache/repos","site_admin":false,"starred_url":"https://api.github.com/users/weizhouapache/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/weizhouapache/subscriptions","type":"User","url":"https://api.github.com/users/weizhouapache"},"description":"","html_url":"https://github.com/apache/cloudstack/milestone/47","id":15843055,"labels_url":"https://api.github.com/repos/apache/cloudstack/milestones/47/labels","node_id":"MI_kwDOAJTq2M4A8b7v","number":47,"open_issues":272,"state":"open","title":"24.0","updated_at":"2026-09-29T10:27:41Z","url":"https://api.github.com/repos/apache/cloudstack/milestones/47"},"node_id":"I_kwDOAJTq2M7hczE1","number":12374,"reactions":{"+1":1,"-1":0,"confused":0,"eyes":2,"heart":2,"hooray":0,"laugh":0,"rocket":0,"total_count":5,"url":"https://api.github.com/repos/apache/cloudstack/issues/12374/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","title":"Support Debian 13 (trixie)","type":{"color":"blue","created_at":"2024-01-25T09:11:09Z","description":"A request, idea, or new functionality","id":93574,"name":"Feature","node_id":"IT_kwDNuP_OAAFthg","updated_at":"2024-10-08T08:30:20Z"},"updated_at":"2026-09-14T15:02:45Z","url":"https://api.github.com/repos/apache/cloudstack/issues/12374","user":{"avatar_url":"https://avatars.githubusercontent.com/u/57355700?v=4","events_url":"https://api.github.com/users/weizhouapache/events{/privacy}","followers_url":"https://api.github.com/users/weizhouapache/followers","following_url":"https://api.github.com/users/weizhouapache/following{/other_user}","gists_url":"https://api.github.com/users/weizhouapache/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/weizhouapache","id":57355700,"login":"weizhouapache","node_id":"MDQ6VXNlcjU3MzU1NzAw","organizations_url":"https://api.github.com/users/weizhouapache/orgs","received_events_url":"https://api.github.com/users/weizhouapache/received_events","repos_url":"https://api.github.com/users/weizhouapache/repos","site_admin":false,"starred_url":"https://api.github.com/users/weizhouapache/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/weizhouapache/subscriptions","type":"User","url":"https://api.github.com/users/weizhouapache"}},{"author_association":"NONE","body":"<!--\r\nVerify first that your issue/request is not already reported on GitHub.\r\nAlso test if the latest release and main branch are affected too.\r\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\r\n-->\r\n\r\n##### ISSUE TYPE\r\n<!-- Pick one below and delete the rest -->\r\n * Other\r\n\r\n##### COMPONENT NAME\r\n<!--\r\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\r\n-->\r\n~~~\r\nUI, System VMs\r\n~~~\r\n\r\n##### CLOUDSTACK VERSION\r\n<!--\r\nNew line separated list of affected versions, commit ID for issues on main branch.\r\n-->\r\n\r\n~~~\r\nCloudStack 4.18\r\n~~~\r\n\r\n##### CONFIGURATION\r\n<!--\r\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\r\n-->\r\nZone with default Advanced networking with Isolation method as VLAN\r\nZone has only one \"Physical Network 1\" with  all traffic types Guest, Management, Public, Storage passing through it\r\nKVM\r\nManagement Server and KVM Host are same. Its a testing environment\r\nOpenVswitch and DPDK enabled and created bridge interface using OpenVswitch commands\r\nPrimany and Secondary with NFS mount points\r\n\r\n##### OS / ENVIRONMENT\r\n<!--\r\nInformation about the environment if relevant, N/A otherwise\r\n-->\r\nUbuntu 22.04.2 LTS\r\nCodename:\tjammy\r\n\r\n##### SUMMARY\r\n<!-- Explain the problem/feature briefly -->\r\n\r\nThe System VMs Agent state is not Up\r\n\r\n##### STEPS TO REPRODUCE\r\n<!--\r\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\r\n\r\nFor new features, show how the feature would be used.\r\n-->\r\n\r\n<!-- Paste example playbooks or commands between quotes below -->\r\n~~~\r\nInstall a fresh new Ubuntu 22.04 LTS server \r\nEnable OpenVswitch and dpdk over the interface and create bridge interface\r\nPerform the install of cloudstack on a server. Also make this server as KVM Host.\r\nConfigure Cloudstack as zone with default advanced networking \r\nZone has only one \"Physical Network 1\" with  all traffic types Guest, Management, Public, Storage \r\npassing through it\r\n~~~\r\n\r\n<!-- You can also paste gist.github.com links for larger files -->\r\n\r\n##### EXPECTED RESULTS\r\n<!-- What did you expect to happen when running the steps above? -->\r\n\r\n~~~\r\nThe System VMs Agent state is  OK\r\n~~~\r\n\r\n##### ACTUAL RESULTS\r\n<!-- What actually happened? -->\r\n\r\n<!-- Paste verbatim command output between quotes below -->\r\n~~~\r\nAfter the Cloudstack install and basic configuration of zone, \r\n\r\nGo system vms section, we notice the state is \"running\" but the  Agent state is not \"OK\"\r\n\r\nAccessed one of the system vm using  commands like  ssh -i /root/.ssh/id_rsa.cloud -p 3922 root@link-local \r\n\r\nIssued command /usr/local/cloud/systemvm/ssvm-check.sh\r\n\r\nNoticed error ERROR: DNS not resolving cloudstack.apache.org\r\n\r\nConfirmed Google DNS server is there at resolv.conf\r\n\r\nChecked the service cloud status and noticed the system vm can't communicate with port 8250 of management server \r\nover the management server IP\r\n\r\nFurther troubleshooting shows from inside system vm, only able to ping management server IP \r\nbut no connection with any active ports of management server like ssh port , management ports like 8250 etc\r\n\r\nWhile checking the traffic over the bridge interface using ovs-tcpdump , we have noticed the \r\nincoming traffic from system vms towards bridge interface are reaching but no outgoing response \r\ntowards system vms. Below is a sample captured traffic at bridge interface over \r\ncloudstack port number  8250. We believe that we setup the openvswitch dpdk setup correctly \r\nand not sure what we are missing from our side.\r\n\r\n12:08:52.312394 IP SVMIP.33940 > MGMTIP.8250: Flags [S], seq 3467199111, win 64240, options [mss 1460,nop,nop,sackOK,nop,wscale 7], length 0\r\n<.............E..4\\.@.@.....?...?... :..B.........................\r\n12:08:53.314315 IP SVMIP.33940 > MGMTIP..8250: Flags [S], seq 3467199111, win 64240, options [mss 1460,nop,nop,sackOK,nop,wscale 7], length 0\r\n\r\nissued the command \"ovs-ofctl dump-flows cloudbr0\" and got below result. Looks like the rule is fine\r\n\r\ncookie=0x0, duration=148279.131s, table=0, n_packets=7453119, n_bytes=2575374706, priority=0 actions=NORMAL\r\n\r\nNot sure what we are missing.\r\n\r\n~~~\r\n","comments":10,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/7473/comments","created_at":"2023-04-26T04:44:30Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/7473/events","html_url":"https://github.com/apache/cloudstack/issues/7473","id":1684259647,"labels":[{"color":"cc317c","default":false,"description":"","id":37843368,"name":"type:question","node_id":"MDU6TGFiZWwzNzg0MzM2OA==","url":"https://api.github.com/repos/apache/cloudstack/labels/type:question"},{"color":"4e62fc","default":false,"description":"","id":1155016910,"name":"status:needs-reproducing","node_id":"MDU6TGFiZWwxMTU1MDE2OTEw","url":"https://api.github.