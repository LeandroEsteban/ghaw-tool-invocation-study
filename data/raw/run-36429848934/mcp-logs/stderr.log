tions_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"comments\":13,\"created_at\":\"2019-11-19T14:10:03Z\",\"updated_at\":\"2026-06-27T14:43:33Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/3693\",\"html_url\":\"https://github.com/apache/cloudstack/issues/3693\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/3693/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/3693/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/3693/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/47\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/47\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/47/labels\",\"id\":15843055,\"number\":47,\"state\":\"open\",\"title\":\"24.0\",\"description\":\"\",\"creator\":{\"login\":\"weizhouapache\",\"id\":57355700,\"node_id\":\"MDQ6VXNlcjU3MzU1NzAw\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/57355700?v=4\",\"html_url\":\"https://github.com/weizhouapache\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/weizhouapache\",\"events_url\":\"https://api.github.com/users/weizhouapache/events{/privacy}\",\"following_url\":\"https://api.github.com/users/weizhouapache/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/weizhouapache/followers\",\"gists_url\":\"https://api.github.com/users/weizhouapache/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/weizhouapache/orgs\",\"received_events_url\":\"https://api.github.com/users/weizhouapache/received_events\",\"repos_url\":\"https://api.github.com/users/weizhouapache/repos\",\"starred_url\":\"https://api.github.com/users/weizhouapache/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/weizhouapache/subscriptions\"},\"open_issues\":271,\"closed_issues\":36,\"created_at\":\"2026-05-08T06:15:20Z\",\"updated_at\":\"2026-09-24T11:07:46Z\",\"node_id\":\"MI_kwDOAJTq2M4A8b7v\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/3693/reactions\"},\"assignees\":[{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"}],\"node_id\":\"MDU6SXNzdWU1MjUwMzM0MjM=\",\"type\":{\"id\":93568,\"node_id\":\"IT_kwDNuP_OAAFtgA\",\"name\":\"Task\",\"description\":\"A specific piece of work\",\"color\":\"yellow\",\"created_at\":\"2024-01-25T09:11:09Z\",\"updated_at\":\"2024-07-26T10:04:57Z\"}},