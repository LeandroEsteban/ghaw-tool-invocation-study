,\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":185,\"closed_issues\":1302,\"created_at\":\"2021-01-04T09:07:50Z\",\"updated_at\":\"2026-09-24T11:01:33Z\",\"node_id\":\"MDk6TWlsZXN0b25lNjI2NTQzNQ==\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6647/reactions\"},\"node_id\":\"I_kwDOAJTq2M5P5bg8\",\"type\":{\"id\":93574,\"node_id\":\"IT_kwDNuP_OAAFthg\",\"name\":\"Feature\",\"description\":\"A request, idea, or new functionality\",\"color\":\"blue\",\"created_at\":\"2024-01-25T09:11:09Z\",\"updated_at\":\"2024-10-08T08:30:20Z\"}},{\"id\":1349721393,\"number\":6672,\"state\":\"open\",\"locked\":false,\"title\":\"After removing SAML auth, user should be able to login via password directly\",\"body\":\"##### ISSUE TYPE\\r\\n * Bug Report\\r\\n\\r\\n##### COMPONENT NAME\\r\\n~~~\\r\\nAPI via cmk\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n~~~\\r\\n4.17.0.1\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\nN/A\\r\\n\\r\\n\\r\\n##### OS / ENVIRONMENT\\r\\nN/A\\r\\n\\r\\n\\r\\n##### SUMMARY\\r\\n\\u003c!-- Explain the problem/feature briefly --\\u003e\\r\\n\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n~~~\\r\\nstep1: add user, add password for this user, play with this user.\\r\\nstep2: enable SAML SSO authentication for this user, either by webui or API\\r\\nstep3: When you choose to remove the SAML SSO authentication, via cmk : authorize samlsso enable=false userid=myuser id\\r\\nstep4: Try to login on webui with failure :)\\r\\n~~~\\r\\n\\r\\n\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\nUser should be able to login on cloudstack web UI\\r\\nWhen SSO is disable the field \\\"source\\\" on user table is SAML2DISABLED\\r\\nWhen SSO has never been activated (and user is able to login via cloudstack directly) this field must be UNKNOWN.\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\nUser can't login on cloudstack web UI\\r\\n\",\"author_association\":\"NONE\",\"user\":{\"login\":\"atmaniak\",\"id\":800433,\"node_id\":\"MDQ6VXNlcjgwMDQzMw==\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/800433?v=4\",\"html_url\":\"https://github.com/atmaniak\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/atmaniak\",\"events_url\":\"https://api.github.com/users/atmaniak/events{/privacy}\",\"following_url\":\"https://api.github.com/users/atmaniak/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/atmaniak/followers\",\"gists_url\":\"https://api.github.com/users/atmaniak/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/atmaniak/orgs\",\"received_events_url\":\"https://api.github.com/users/atmaniak/received_events\",\"repos_url\":\"https://api.github.com/users/atmaniak/repos\",\"starred_url\":\"https://api.github.com/users/atmaniak/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/atmaniak/subscriptions\"},\"labels\":[{\"id\":817420428,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:improvement\",\"name\":\"type:improvement\",\"color\":\"a5f9ff\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWw4MTc0MjA0Mjg=\"}],\"comments\":5,\"created_at\":\"2022-08-24T16:23:19Z\",\"updated_at\":\"2026-04-24T11:42:51Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6672\",\"html_url\":\"https://github.com/apache/cloudstack/issues/6672\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6672/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6672/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6672/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/46\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/46\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/46/labels\",\"id\":15514689,\"number\":46,\"state\":\"open\",\"title\":\"4.22.2\",\"description\":\"\",\"creator\":{\"login\":\"sureshanaparti\",\"id\":12028987,\"node_id\":\"MDQ6VXNlcjEyMDI4OTg3\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/12028987?v=4\",\"html_url\":\"https://github.com/sureshanaparti\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/sureshanaparti\",\"events_url\":\"https://api.github.com/users/sureshanaparti/events{/privacy}\",\"following_url\":\"https://api.github.com/users/sureshanaparti/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/sureshanaparti/followers\",\"gists_url\":\"https://api.github.com/users/sureshanaparti/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/sureshanaparti/orgs\",\"received_events_url\":\"https://api.github.com/users/sureshanaparti/received_events\",\"repos_url\":\"https://api.github.com/users/sureshanaparti/repos\",\"starred_url\":\"https://api.github.com/users/sureshanaparti/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/sureshanaparti/subscriptions\"},\"open_issues\":253,\"closed_issues\":112,\"created_at\":\"2026-04-13T07:02:43Z\",\"updated_at\":\"2026-09-28T10:46:21Z\",\"node_id\":\"MI_kwDOAJTq2M4A7LxB\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6672/reactions\"},\"node_id\":\"I_kwDOAJTq2M5Qcx0x\",\"type\":{\"id\":93574,\"node_id\":\"IT_kwDNuP_OAAFthg\",\"name\":\"Feature\",\"description\":\"A request, idea, or new functionality\",\"color\":\"blue\",\"created_at\":\"2024-01-25T09:11:09Z\",\"updated_at\":\"2024-10-08T08:30:20Z\"}},{\"id\":1362269910,\"number\":6703,\"state\":\"open\",\"locked\":false,\"title\":\"Introduce a \\\"session timeout\\\" counter in GUI\",\"body\":\"\\u003c!--\\r\\nVerify first that your issue/request is not already reported on GitHub.\\r\\nAlso test if the latest release and main branch are affected too.\\r\\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\\r\\n--\\u003e\\r\\n\\r\\n##### ISSUE TYPE\\r\\n\\u003c!-- Pick one below and delete the rest --\\u003e\\r\\n\\r\\n * Feature Idea\\r\\n\\r\\n\\r\\n##### COMPONENT NAME\\r\\n\\u003c!--\\r\\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\\r\\n--\\u003e\\r\\n~~~\\r\\nUI\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n\\u003c!--\\r\\nNew line separated list of affected versions, commit ID for issues on main branch.\\r\\n--\\u003e\\r\\n\\r\\n~~~\\r\\n4.17.0.1\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\n\\u003c!--\\r\\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\\r\\n--\\u003e\\r\\nN/A\\r\\n\\r\\n##### OS / ENVIRONMENT\\r\\n\\u003c!--\\r\\nInformation about the environment if relevant, N/A otherwise\\r\\n--\\u003e\\r\\nN/A\\r\\n\\r\\n##### SUMMARY\\r\\n\\u003c!-- Explain the problem/feature briefly --\\u003e\\r\\nI would like to have a \\\"counter\\\" in the UI showing the time until the current session is closed and the user needs to authenticate again. In addition a button to \\\"refresh\\\" the session / restart the session time-out would be quite convenient.\\r\\nFor positioning i would suggest to place this in the top menue right beside the username and button for changeing the language-settings\\r\\n\\r\\n![Screenshot 2022-09-05 183408](https://user-images.githubusercontent.com/79725167/188490112-f261b42c-fa62-4957-add2-8583f245a643.jpg)\\r\\n\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n\\u003c!--\\r\\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\\r\\n\\r\\nFor new features, show how the feature would be used.\\r\\n--\\u003e\\r\\n\\r\\n\\u003c!-- Paste example playbooks or commands between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n\\u003c!-- You can also paste gist.github.com links for larger files --\\u003e\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\n\\u003c!-- What did you expect to happen when running the steps above? --\\u003e\\r\\n\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n\\u003c!-- What actually happened? --\\u003e\\r\\n\\r\\n\\u003c!-- Paste verbatim command output between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\",\"author_association\":\"NONE\",\"user\":{\"login\":\"Hudratronium\",\"id\":79725167,\"node_id\":\"MDQ6VXNlcjc5NzI1MTY3\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/79725167?v=4\",\"html_url\":\"https://github.com/Hudratronium\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/Hudratronium\",\"events_url\":\"https://api.github.com/users/Hudratronium/events{/privacy}\",\"following_url\":\"https://api.github.com/users/Hudratronium/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/Hudratronium/followers\",\"gists_url\":\"https://api.github.com/users/Hudratronium/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/Hudratronium/orgs\",\"received_events_url\":\"https://api.github.com/users/Hudratronium/received_events\",\"repos_url\":\"https://api.github.com/users/Hudratronium/repos\",\"starred_url\":\"https://api.github.com/users/Hudratronium/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/Hudratronium/subscriptions\"},\"labels\":[{\"id\":6890295339,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:stale\",\"name\":\"status:stale\",\"color\":\"E43179\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAABmrGQKw\"}],\"comments\":9,\"created_at\":\"2022-09-05T16:35:54Z\",\"updated_at\":\"2026-05-26T10:57:21Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6703\",\"html_url\":\"https://github.com/apache/cloudstack/issues/6703\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6703/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6703/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6703/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/19\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19/labels\",\"id\":6265435,\"number\":19,\"state\":\"open\",\"title\":\"unplanned\",\"creator\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":185,\"closed_issues\":1302,\"created_at\":\"2021-01-04T09:07:50Z\",\"updated_at\":\"2026-09-24T11:01:33Z\",\"node_id\":\"MDk6TWlsZXN0b25lNjI2NTQzNQ==\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6703/reactions\"},\"node_id\":\"I_kwDOAJTq2M5RMpbW\"},{\"id\":1364832398,\"number\":6714,\"state\":\"open\",\"locked\":false,\"title\":\"Prometheus exporter - interpret ::1 as 0:0:0:0:0:0:0:1\",\"body\":\"Hi,\\r\\n\\r\\nIf I configure the Prometheus exporter to allow requests from ::1 (ipv6 localhost, short form) it doesn't actually honour requests.\\r\\n\\r\\nIn the logs you can see entries such as:\\r\\n```Prometheus exporter received client request from: 0:0:0:0:0:0:0:1```\\r\\n\\r\\nIndeed, once you add 0:0:0:0:0:0:0:1 (ipv6 localhost, medium form) it starts working.\\r\\n\\r\\nIt's a minor issue, but nice to get sorted as most people are used to ::1.\",\"author_association\":\"CONTRIBUTOR\",\"user\":{\"login\":\"NuxRo\",\"id\":2357012,\"node_id\":\"MDQ6VXNlcjIzNTcwMTI=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2357012?v=4\",\"html_url\":\"https://github.com/NuxRo\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/NuxRo\",\"events_url\":\"https://api.github.com/users/NuxRo/events{/privacy}\",\"following_url\":\"https://api.github.com/users/NuxRo/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/NuxRo/followers\",\"gists_url\":\"https://api.github.com/users/NuxRo/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/NuxRo/orgs\",\"received_events_url\":\"https://api.github.com/users/NuxRo/received_events\",\"repos_url\":\"https://api.github.com/users/NuxRo/repos\",\"starred_url\":\"https://api.github.com/users/NuxRo/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/NuxRo/subscriptions\"},\"labels\":[{\"id\":37843364,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:bug\",\"name\":\"type:bug\",\"color\":\"fc2929\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwzNzg0MzM2NA==\"},{\"id\":1391967979,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/Severity:Trivial\",\"name\":\"Severity:Trivial\",\"color\":\"e08888\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwxMzkxOTY3OTc5\"},{\"id\":4507982790,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/ipv6\",\"name\":\"ipv6\",\"color\":\"C744C9\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAABDLJbxg\"},{\"id\":5651870091,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:prometheus\",\"name\":\"component:prometheus\",\"color\":\"E265FC\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAABUOCxiw\"},{\"id\":6890295339,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:stale\",\"name\":\"status:stale\",\"color\":\"E43179\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAABmrGQKw\"}],\"comments\":3,\"created_at\":\"2022-09-07T15:18:25Z\",\"updated_at\":\"2026-06-29T08:38:57Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6714\",\"html_url\":\"https://github.com/apache/cloudstack/issues/6714\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6714/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6714/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6714/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/46\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/46\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/46/labels\",\"id\":15514689,\"number\":46,\"state\":\"open\",\"title\":\"4.22.2\",\"description\":\"\",\"creator\":{\"login\":\"sureshanaparti\",\"id\":12028987,\"node_id\":\"MDQ6VXNlcjEyMDI4OTg3\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/12028987?v=4\",\"html_url\":\"https://github.com/sureshanaparti\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/sureshanaparti\",\"events_url\":\"https://api.github.com/users/sureshanaparti/events{/privacy}\",\"following_url\":\"https://api.github.com/users/sureshanaparti/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/sureshanaparti/followers\",\"gists_url\":\"https://api.github.com/users/sureshanaparti/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/sureshanaparti/orgs\",\"received_events_url\":\"https://api.github.com/users/sureshanaparti/received_events\",\"repos_url\":\"https://api.github.com/users/sureshanaparti/repos\",\"starred_url\":\"https://api.github.com/users/sureshanaparti/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/sureshanaparti/subscriptions\"},\"open_issues\":253,\"closed_issues\":112,\"created_at\":\"2026-04-13T07:02:43Z\",\"updated_at\":\"2026-09-28T10:46:21Z\",\"node_id\":\"MI_kwDOAJTq2M4A7LxB\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6714/reactions\"},\"node_id\":\"I_kwDOAJTq2M5RWbCO\"},{\"id\":1365767365,\"number\":6715,\"state\":\"open\",\"locked\":false,\"title\":\"ControlNetworkGuru does not take into account custom CIDR when assigning System VM link local IP address\",\"body\":\"##### ISSUE TYPE\\r\\n * Bug Report\\r\\n\\r\\n##### COMPONENT NAME\\r\\n~~~\\r\\nManagement, Network, SystemVM\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n~~~\\r\\n4.16.1\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\nIn database:\\r\\n```\\r\\nMariaDB [cloud]\\u003e select name,value from configuration where name = 'control.cidr';\\r\\n+--------------+------------------+\\r\\n| name         | value            |\\r\\n+--------------+------------------+\\r\\n| control.cidr | 169.254.240.0/20 |\\r\\n+--------------+------------------+\\r\\nMariaDB [cloud]\\u003e select name,value from configuration where name = 'control.gateway';\\r\\n+-----------------+---------------+\\r\\n| name            | value         |\\r\\n+-----------------+---------------+\\r\\n| control.gateway | 169.254.240.1 |\\r\\n+-----------------+---------------+\\r\\nMariaDB [cloud]\\u003e select count(*) from op_dc_link_local_ip_address_alloc;\\r\\n+----------+\\r\\n| count(*) |\\r\\n+----------+\\r\\n|    65533 |\\r\\n+----------+\\r\\n```\\r\\nOn agent:\\r\\n```\\r\\nroot@hv-04-02-21:~# grep control.cidr /etc/cloudstack/agent/agent.properties\\r\\ncontrol.cidr=169.254.240.0/20\\r\\n```\\r\\n\\r\\n##### SUMMARY\\r\\nWhen having set a `control.cidr` different from the norm (`168.254.0.0/16`) and the database table `op_dc_link_local_ip_address_alloc` is already populated with all the addresses in the default CIDR, then allocating an IP to a System VM does not take into account the requested CIDR, thus allocating an IP address in the wrong range.\\r\\n\\r\\nhttps://github.com/apache/cloudstack/blob/main/engine/schema/src/main/java/com/cloud/dc/dao/DataCenterLinkLocalIpAddressDaoImpl.java#L52 should take this into account. This function is called in https://github.com/apache/cloudstack/blob/main/server/src/main/java/com/cloud/network/guru/ControlNetworkGuru.java#L134\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n- Install new management server\\r\\n- After kickstart, disable the zone to prevent any system vm deploys\\r\\n- In mysql database: `select count(*) from op_dc_link_local_ip_address_alloc;`, it would return `65533`\\r\\n- Connect agents\\r\\n- Configure `control.cidr` on the manager and agents, and `control.gateway` on the manager, ie:\\r\\n```\\r\\ncontrol.cidr=169.254.240.0/20\\r\\ncontrol.gateway=169.254.240.1\\r\\n```\\r\\n- Enable the zone, check the system vm link local address\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\n- The System VMs should receive an IP address in the configured CIDR.\\r\\n- Additional expected: In mysql database: `select count(*) from op_dc_link_local_ip_address_alloc;`, it should return `4093`\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n- System VMs receive an IP address in the default `169.254.0.0/16` range\\r\\n```\\r\\n2022-09-07 22:45:35,338 DEBUG [o.a.c.e.o.NetworkOrchestrator] (Work-Job-Executor-3:ctx-b1c76634 job-149/job-150 ctx-224681ec) (logid:32608415) Network id=201 is already implemented\\r\\n2022-09-07 22:45:35,524 DEBUG [c.c.n.g.ControlNetworkGuru] (Work-Job-Executor-3:ctx-b1c76634 job-149/job-150 ctx-224681ec) (logid:32608415) Reserved NIC for v-18-VM [ipv4:169.254.167.69 netmask:255.255.240.0 gateway:169.254.240.1]\\r\\n```\\r\\n\",\"author_association\":\"CONTRIBUTOR\",\"user\":{\"login\":\"Rubueno\",\"id\":8641284,\"node_id\":\"MDQ6VXNlcjg2NDEyODQ=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/8641284?v=4\",\"html_url\":\"https://github.com/Rubueno\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/Rubueno\",\"events_url\":\"https://api.github.com/users/Rubueno/events{/privacy}\",\"following_url\":\"https://api.github.com/users/Rubueno/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/Rubueno/followers\",\"gists_url\":\"https://api.github.com/users/Rubueno/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/Rubueno/orgs\",\"received_events_url\":\"https://api.github.com/users/Rubueno/received_events\",\"repos_url\":\"https://api.github.com/users/Rubueno/repos\",\"starred_url\":\"https://api.github.com/users/Rubueno/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/Rubueno/subscriptions\"},\"labels\":[{\"id\":584072971,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:kvm\",\"name\":\"component:kvm\",\"color\":\"006b75\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWw1ODQwNzI5NzE=\"},{\"id\":592559219,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:networking\",\"name\":\"component:networking\",\"color\":\"f9d0c4\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWw1OTI1NTkyMTk=\"},{\"id\":1391968610,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/Severity:Minor\",\"name\":\"Severity:Minor\",\"color\":\"906666\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwxMzkxOTY4NjEw\"},{\"id\":2694797573,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:needs-investigation\",\"name\":\"status:needs-investigation\",\"color\":\"906C28\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwyNjk0Nzk3NTcz\"},{\"id\":6890295339,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:stale\",\"name\":\"status:stale\",\"color\":\"E43179\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAABmrGQKw\"},{\"id\":9849008471,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/no-issue-activity\",\"name\":\"no-issue-activity\",\"color\":\"ededed\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSwvxVw\"}],\"comments\":2,\"created_at\":\"2022-09-08T08:18:52Z\",\"updated_at\":\"2026-05-23T02:17:23Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6715\",\"html_url\":\"https://github.com/apache/cloudstack/issues/6715\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6715/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6715/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6715/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/19\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19/labels\",\"id\":6265435,\"number\":19,\"state\":\"open\",\"title\":\"unplanned\",\"creator\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":185,\"closed_issues\":1302,\"created_at\":\"2021-01-04T09:07:50Z\",\"updated_at\":\"2026-09-24T11:01:33Z\",\"node_id\":\"MDk6TWlsZXN0b25lNjI2NTQzNQ==\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6715/reactions\"},\"node_id\":\"I_kwDOAJTq2M5RZ_TF\"},{\"id\":1367074379,\"number\":6718,\"state\":\"open\",\"locked\":false,\"title\":\"conntrackd filling up var\",\"body\":\"##### ISSUE TYPE\\r\\n * Bug Report\\r\\n\\r\\n##### COMPONENT NAME\\r\\n~~~\\r\\nVR\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n~~~\\r\\nlatest\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\n~~~\\r\\nN/A\\r\\n~~~\\r\\n\\r\\n##### OS / ENVIRONMENT\\r\\n~~~\\r\\nKVM\\r\\n~~~\\r\\n\\r\\n##### SUMMARY\\r\\n~~~\\r\\nWe have large customers with a lot of VR traffic traversing the VRs.  Logrotate cannot keep up and /var fills up to 100%, causing the VR to exhibit problems when attempting to start/restart instances in the VPC and/or traffic stops flowing.  Conntrackd is logging verbosely to daemon.log.\\r\\n~~~\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n~~~\\r\\n\\r\\n1. Construct a VPC with a redundant VR pair with a private gateway or tunnel\\r\\n2. Create a large amount of traffic to/from a VPC over gateway or tunnel\\r\\n\\r\\n~~~\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\n~~~\\r\\n/var should not fill up regardless of traffic load\\r\\n~~~\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n~~~\\r\\n/var fills up\\r\\n~~~\",\"author_association\":\"NONE\",\"user\":{\"login\":\"ghost\",\"id\":10137,\"node_id\":\"MDQ6VXNlcjEwMTM3\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/10137?v=4\",\"html_url\":\"https://github.com/ghost\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/ghost\",\"events_url\":\"https://api.github.com/users/ghost/events{/privacy}\",\"following_url\":\"https://api.github.com/users/ghost/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/ghost/followers\",\"gists_url\":\"https://api.github.com/users/ghost/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/ghost/orgs\",\"received_events_url\":\"https://api.github.com/users/ghost/received_events\",\"repos_url\":\"https://api.github.com/users/ghost/repos\",\"starred_url\":\"https://api.github.com/users/ghost/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/ghost/subscriptions\"},\"labels\":[{\"id\":37843364,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:bug\",\"name\":\"type:bug\",\"color\":\"fc2929\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwzNzg0MzM2NA==\"},{\"id\":584073391,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:virtual-router\",\"name\":\"component:virtual-router\",\"color\":\"ffaaeb\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWw1ODQwNzMzOTE=\"},{\"id\":1082374171,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:logging\",\"name\":\"component:logging\",\"color\":\"eaa498\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwxMDgyMzc0MTcx\"},{\"id\":1391968610,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/Severity:Minor\",\"name\":\"Severity:Minor\",\"color\":\"906666\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwxMzkxOTY4NjEw\"},{\"id\":2694797573,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:needs-investigation\",\"name\":\"status:needs-investigation\",\"color\":\"906C28\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwyNjk0Nzk3NTcz\"},{\"id\":6890295339,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:stale\",\"name\":\"status:stale\",\"color\":\"E43179\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAABmrGQKw\"},{\"id\":9849008471,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/no-issue-activity\",\"name\":\"no-issue-activity\",\"color\":\"ededed\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSwvxVw\"}],\"comments\":3,\"created_at\":\"2022-09-08T22:58:16Z\",\"updated_at\":\"2026-05-27T02:18:45Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6718\",\"html_url\":\"https://github.com/apache/cloudstack/issues/6718\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6718/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6718/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6718/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/19\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19/labels\",\"id\":6265435,\"number\":19,\"state\":\"open\",\"title\":\"unplanned\",\"creator\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":185,\"closed_issues\":1302,\"created_at\":\"2021-01-04T09:07:50Z\",\"updated_at\":\"2026-09-24T11:01:33Z\",\"node_id\":\"MDk6TWlsZXN0b25lNjI2NTQzNQ==\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6718/reactions\"},\"node_id\":\"I_kwDOAJTq2M5Re-ZL\"},{\"id\":1368274307,\"number\":6726,\"state\":\"open\",\"locked\":false,\"title\":\"INSTALL.md is incomplete and/or outdated\",\"body\":\"\\u003c!--\\r\\nVerify first that your issue/request is not already reported on GitHub.\\r\\nAlso test if the latest release and main branch are affected too.\\r\\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\\r\\n--\\u003e\\r\\n\\r\\n##### ISSUE TYPE\\r\\n\\u003c!-- Pick one below and delete the rest --\\u003e\\r\\n * Documentation Report\\r\\n\\r\\n##### COMPONENT NAME\\r\\n\\u003c!--\\r\\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\\r\\n--\\u003e\\r\\n~~~\\r\\nBuild instructions\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n\\u003c!--\\r\\nNew line separated list of affected versions, commit ID for issues on main branch.\\r\\n--\\u003e\\r\\n\\r\\n~~~\\r\\n4.16\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\n\\u003c!--\\r\\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\\r\\n--\\u003e\\r\\n\\r\\n\\r\\n##### OS / ENVIRONMENT\\r\\n\\u003c!--\\r\\nInformation about the environment if relevant, N/A otherwise\\r\\n--\\u003e\\r\\n\\r\\nCentOS 7\\r\\n\\r\\n##### SUMMARY\\r\\n\\u003c!-- Explain the problem/feature briefly --\\u003e\\r\\nI tried to follow the steps in INSTALL.md to build CloudStack on CentOS 7.  The instructions aren't working.  They seem to be missing some steps, and I wonder if some of the dependency version numbers are outdated (e.g. Maven 3.6.3).\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n\\u003c!--\\r\\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\\r\\n\\r\\nFor new features, show how the feature would be used.\\r\\n--\\u003e\\r\\n\\r\\n\\u003c!-- Paste example playbooks or commands between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n\\u003c!-- You can also paste gist.github.com links for larger files --\\u003e\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\n\\u003c!-- What did you expect to happen when running the steps above? --\\u003e\\r\\n\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n\\u003c!-- What actually happened? --\\u003e\\r\\n\\r\\n\\u003c!-- Paste verbatim command output between quotes below --\\u003e\\r\\n~~~\\r\\nI had to add a MySQL repository before yum could install MySQL.  I didn't know which version to use, so I picked 7.5 because it's used in the quick installation guide.\\r\\n\\r\\n```\\r\\nwget http://repo.mysql.com/mysql-community-release-el7-5.noarch.rpm\\r\\nrpm -ivh mysql-community-release-el7-5.noarch.rpm\\r\\n```\\r\\n\\r\\nIn the `Install tools and dependencies` section, I needed to add bzip2 and python3 to the yum command.\\r\\n\\r\\nThe Maven download URL doesn't work.  You could change the domain name from www.us.apache.org to archive.apache.org.  That would work, but you'd still get an old version.  I found it was much easier to just use sdkman.io to install the latest version.\\r\\n\\r\\nThose changes were enough for the build to succeed.  But I couldn't create the DB schema.  I'm wondering if that part of the process needs an older version of MySQL.\\r\\n~~~\\r\\n\",\"author_association\":\"CONTRIBUTOR\",\"user\":{\"login\":\"mrog\",\"id\":4752942,\"node_id\":\"MDQ6VXNlcjQ3NTI5NDI=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/4752942?v=4\",\"html_url\":\"https://github.com/mrog\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/mrog\",\"events_url\":\"https://api.github.com/users/mrog/events{/privacy}\",\"following_url\":\"https://api.github.com/users/mrog/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/mrog/followers\",\"gists_url\":\"https://api.github.com/users/mrog/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/mrog/orgs\",\"received_events_url\":\"https://api.github.com/users/mrog/received_events\",\"repos_url\":\"https://api.github.com/users/mrog/repos\",\"starred_url\":\"https://api.github.com/users/mrog/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/mrog/subscriptions\"},\"labels\":[{\"id\":2479281588,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:documentation\",\"name\":\"component:documentation\",\"color\":\"8236aa\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwyNDc5MjgxNTg4\"},{\"id\":6890295339,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:stale\",\"name\":\"status:stale\",\"color\":\"E43179\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAABmrGQKw\"},{\"id\":9849008471,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/no-issue-activity\",\"name\":\"no-issue-activity\",\"color\":\"ededed\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSwvxVw\"}],\"assignee\":{\"login\":\"kiranchavala\",\"id\":1401014,\"node_id\":\"MDQ6VXNlcjE0MDEwMTQ=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/1401014?v=4\",\"html_url\":\"https://github.com/kiranchavala\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/kiranchavala\",\"events_url\":\"https://api.github.com/users/kiranchavala/events{/privacy}\",\"following_url\":\"https://api.github.com/users/kiranchavala/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/kiranchavala/followers\",\"gists_url\":\"https://api.github.com/users/kiranchavala/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/kiranchavala/orgs\",\"received_events_url\":\"https://api.github.com/users/kiranchavala/received_events\",\"repos_url\":\"https://api.github.com/users/kiranchavala/repos\",\"starred_url\":\"https://api.github.com/users/kiranchavala/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/kiranchavala/subscriptions\"},\"comments\":4,\"created_at\":\"2022-09-09T20:07:57Z\",\"updated_at\":\"2026-08-17T02:00:25Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6726\",\"html_url\":\"https://github.com/apache/cloudstack/issues/6726\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6726/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6726/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/6726/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/19\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/19/labels\",\"id\":6265435,\"number\":19,\"state\":\"open\",\"title\":\"unplanned\",\"creator\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":185,\"closed_issues\":1302,\"created_at\":\"2021-01-04T09:07:50Z\",\"updated_at\":\"2026-09-24T11:01:33Z\",\"node_id\":\"MDk6TWlsZXN0b25lNjI2NTQzNQ==\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/6726/reactions\"},\"assignees\":[{\"login\":\"kiranchavala\",\"id\":1401014,\"node_id\":\"MDQ6VXNlcjE0MDEwMTQ=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/1401014?v=4\",\"html_url\":\"https://github.com/kiranchavala\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/kiranchavala\",\"events_url\":\"https://api.github.com/users/kiranchavala/events{/privacy}\",\"following_url\":\"https://api.github.com/users/kiranchavala/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/kiranchavala/followers\",\"gists_url\":\"https://api.github.com/users/kiranchavala/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/kiranchavala/orgs\",\"received_events_url\":\"https://api.github.com/users/kiranchavala/received_events\",\"repos_url\":\"https://api.github.com/users/kiranchavala/repos\",\"starred_url\":\"https://api.github.com/users/kiranchavala/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/kiranchavala/subscriptions\"}],\"node_id\":\"I_kwDOAJTq2M5RjjWD\"},{\"id\":1376117413,\"number\":6746,\"state\":\"open\",\"locked\":false,\"title\":\"Fix potential leaking of volume maps\",\"body\":\"\\u003c!--\\r\\nVerify first that your issue/request is not already reported on GitHub.\\r\\nAlso test if the latest release and main branch are affected too.\\r\\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\\r\\n--\\u003e\\r\\n\\r\\n##### ISSUE TYPE\\r\\n * Enhancement Request\\r\\n \\r\\n##### COMPONENT NAME\\r\\n~~~\\r\\nStorage\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n~~~\\r\\nAny\\r\\n~~~\\r\\n\\r\\n##### SUMMARY\\r\\nUnmapping volumes from a hypervisor host upon VM stop or migration is done on a best-effort basis. The VM is already stopped, or already migrated, we try to unmap, but if something goes wrong there is really no recourse or retry and a warning is logged.  This leaves a potential of leaking maps to hosts over time.\\r\\n\\r\\nIn code review I've also found edge cases where a VM is moved to \\\"Stopped\\\" state without necessarily cleaning up network or volume resources, these can also lead to leaked maps over time. Examples are force removing a hypervisor host with running VMs on it, and possibly any other code that just calls `vm.setState(State.Stopped)`.\\r\\n\\r\\nMy request is that we be more thorough during VM start in ensuring that our target host and *only* our target host has access to the volume.  Or at least call the storage plugin involved to let it decide how to do this. It should be as simple as calling the storage service to \\\"revoke all\\\" just before we grant access, or allowing for an exclusive grant in the storage API.\\r\\n\\r\\nFor example, with the PowerFlex/ScaleIO storage client there is an `unmapVolumeFromAllSdcs` that could be called just prior to granting access to volumes during VM start. \\r\\n\\r\\nWe may need to add a `revokeAllAccess()` method to the `PrimaryDataStoreDriver`, or add a flag to the existing `revokeAccess` to indicate that the storage driver should revoke all.  \\r\\n\\r\\nOr alternatively (I think I like this better), the `grantAccess()` call might gain a flag `boolean exclusive` so the storage driver can be instructed to ensure that only one mapping exists - the one requested.  This would be cleaner.\\r\\n\\r\\nCrucially - we need to avoid exclusive access during the live migration workflows. It seems safe to ensure exclusive access during VM start, however.\\r\\n\",\"author_association\":\"CONTRIBUTOR\",\"user\":{\"login\":\"mlsorensen\",\"id\":1047709,\"node_id\":\"MDQ6VXNlcjEwNDc3MDk=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/1047709?v=4\",\"html_url\":\"https://github.com/mlsorensen\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/mlsorensen\",\"events_url\":\"https://api.github.com/users/mlsorensen/events{/privacy}\",\"following_url\":\"https://api.github.com/users/mlsorensen/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/mlsorensen/followers\",\"gists_url\":\"https://api.github.com/users/mlsorensen/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/mlsorensen/orgs\",\"received_events_url\":\"https://api.github.com/users/mlsorensen/received_events\",\"repos_url\":\"https://api.github.com/users/mlsorensen/repos\",\"starred_url\":\"https://api.github.com/users/mlsorensen/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/mlsorensen/subscriptions\"},\"labels\":[{\"id\":37843366,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:enhancement\",\"name\":\"type:enhancement\",\"color\":\"84b6eb\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwzNzg0MzM2Ng==\"},{\"id\":4006883948,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:storage\",\"name\":\"component:storage\",\"color\":\"1D76DB\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M7u1DJs\"},{\"id\":6890295339,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/status:stale\",\"name\":\"status:stale\",\"color\":\"E43179\",\"description\":\"\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAABmrGQKw\"},{\"id\":9849008471,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/no-issue-activity\",\"name\":\"no-issue-activity\",\"color\":\"ededed\",\"default\":false,\"node_id\":\"LA_kwDOAJTq2M8AAAACSwvxVw\"}],\"comme