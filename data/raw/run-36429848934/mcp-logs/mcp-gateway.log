ost HA, not sure if this should be a smoke test!?\r\n\r\n##### ISSUE TYPE\r\n\u003c!-- Pick one below and delete the rest --\u003e\r\n * Bug Report\r\n * Other: test improvements\r\n","comments":13,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/3693/comments","created_at":"2019-11-19T14:10:03Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/3693/events","html_url":"https://github.com/apache/cloudstack/issues/3693","id":525033423,"labels":[{"color":"bfd4f2","default":false,"description":"","id":589162089,"name":"status:work-in-progress","node_id":"MDU6TGFiZWw1ODkxNjIwODk=","url":"https://api.github.com/repos/apache/cloudstack/labels/status:work-in-progress"},{"color":"0e8a16","default":false,"description":"","id":821716113,"name":"type:cleanup","node_id":"MDU6TGFiZWw4MjE3MTYxMTM=","url":"https://api.github.com/repos/apache/cloudstack/labels/type:cleanup"},{"color":"52a8ea","default":false,"description":"","id":1900337335,"name":"type:technical-debt","node_id":"MDU6TGFiZWwxOTAwMzM3MzM1","url":"https://api.github.com/repos/apache/cloudstack/labels/type:technical-debt"},{"color":"e858a2","default":false,"description":"","id":2510052725,"name":"component:integration-test","node_id":"MDU6TGFiZWwyNTEwMDUyNzI1","url":"https://api.github.com/repos/apache/cloudstack/labels/component:integration-test"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/3693/labels{/name}","locked":false,"milestone":{"closed_issues":36,"created_at":"2026-05-08T06:15:20Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/57355700?v=4","events_url":"https://api.github.com/users/weizhouapache/events{/privacy}","followers_url":"https://api.github.com/users/weizhouapache/followers","following_url":"https://api.github.com/users/weizhouapache/following{/other_user}","gists_url":"https://api.github.com/users/weizhouapache/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/weizhouapache","id":57355700,"login":"wei