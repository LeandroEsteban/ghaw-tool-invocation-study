~~~\r\n4.16.0\r\n~~~\r\n\r\n##### CONFIGURATION\r\nXCP-NG 8.2\r\nAdvanced Zone\r\n\r\n##### OS / ENVIRONMENT\r\nOracle Linux 8.4 - Management server, MYSQL 8.0.26\r\nXCP-NG 8.2 - hypervisor\r\n\r\n##### SUMMARY\r\nUser from domain1 can't deploy VM in dedicated to domain1 pod.\r\n\r\n##### STEPS TO REPRODUCE\r\n~~~\r\nCreate domain. Create user in this domain. Dedicate pod to this domain. Create Compute offering with ImplicitDedicationPlanner with strict policy and choose domain1.\r\n~~~\r\n##### EXPECTED RESULTS\r\n~~~\r\nAll users from this domain can deploy VMs only in this Pod\r\n~~~\r\n\r\n##### ACTUAL RESULTS\r\n~~~\r\nUser from this domain can't deploy VM in dedicated pod. \r\n~~~\r\n","comments":50,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/5803/comments","created_at":"2021-12-23T08:27:49Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/5803/events","html_url":"https://github.com/apache/cloudstack/issues/5803","id":1087489320,"labels":[{"color":"84b6eb","default":false,"description":"","id":37843366,"name":"type:enhancement","node_id":"MDU6TGFiZWwzNzg0MzM2Ng==","url":"https://api.github.com/repos/apache/cloudstack/labels/type:enhancement"},{"color":"951862","default":false,"description":"","id":2630836378,"name":"status:needs-functional-definition","node_id":"MDU6TGFiZWwyNjMwODM2Mzc4","url":"https://api.github.com/repos/apache/cloudstack/labels/status:needs-functional-definition"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/5803/labels{/name}","locked":false,"milestone":{"closed_issues":1302,"created_at":"2021-01-04T09:07:50Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/2486961?v=4","events_url":"https://api.github.com/users/DaanHoogland/events{/privacy}","followers_url":"https://api.github.com/users/DaanHoogland/followers","following_url":"https://api.github.com/users/DaanHoogland/following{/other_user}","gists_url":"https://api.github.com/users/DaanHoogland/gists{/