2028987,\"node_id\":\"MDQ6VXNlcjEyMDI4OTg3\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/12028987?v=4\",\"html_url\":\"https://github.com/sureshanaparti\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/sureshanaparti\",\"events_url\":\"https://api.github.com/users/sureshanaparti/events{/privacy}\",\"following_url\":\"https://api.github.com/users/sureshanaparti/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/sureshanaparti/followers\",\"gists_url\":\"https://api.github.com/users/sureshanaparti/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/sureshanaparti/orgs\",\"received_events_url\":\"https://api.github.com/users/sureshanaparti/received_events\",\"repos_url\":\"https://api.github.com/users/sureshanaparti/repos\",\"starred_url\":\"https://api.github.com/users/sureshanaparti/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/sureshanaparti/subscriptions\"},\"open_issues\":253,\"closed_issues\":112,\"created_at\":\"2026-04-13T07:02:43Z\",\"updated_at\":\"2026-09-28T10:46:21Z\",\"node_id\":\"MI_kwDOAJTq2M4A7LxB\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/3253/reactions\"},\"node_id\":\"MDU6SXNzdWU0Mjc3NTg0NTE=\"},{\"id\":449140959,\"number\":3360,\"state\":\"open\",\"locked\":false,\"title\":\"details is an ambigue parameter name\",\"body\":\"\\u003c!--\\nVerify first that your issue/request is not already reported on GitHub.\\nAlso test if the latest release and master branch are affected too.\\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\\n--\\u003e\\nthe parameter name 'details' can mean different things in different API calls. These should be aligned and/or renamed. see the discussion in #3331\\n\\n##### ISSUE TYPE\\n * Improvement Request\\n\\n##### COMPONENT NAME\\n\\u003c!--\\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\\n--\\u003e\\n~~~\\nAPI\\n~~~\\n\\n##### CLOUDSTACK VERSION\\n\\u003c!--\\nNew line separated list of affected versions, commit ID for issues on master branch.\\n--\\u003e\\n\\n~~~\\nall\\n~~~\\n\\n##### SUMMARY\\n\\n\\n| type of details field | class |\\n| - | -  |\\n| | Commands: |\\n| Map | RegisterOAuthProviderCmd.java |\\nMap | BaseUpdateTemplateOrIsoCmd.java\\nList\\\\\\u003cString\\u003e | ListHostsCmd.java\\nMap | UpdateZoneCmd.java\\nMap | CreateNetworkOfferingCmd.java\\nMap | UpdateBgpPeerCmd.java\\nMap | CreateBgpPeerCmd.java\\nMap\\u003cString, String\\u003e | UpgradeSystemVMCmd.java\\nMap\\u003cString, String\\u003e | ScaleSystemVMCmd.java\\nMap | UpdateStoragePoolCmd.java\\nMap | UpdateCloudToUseObjectStoreCmd.java\\nMap | AddImageStoreCmd.java\\nMap\\u003cString, ? extends Map\\u003cString, String\\u003e\\u003e | CreateSecondaryStagingStoreCmd.java\\nMap | AddObjectStoragePoolCmd.java\\nMap | CreateStoragePoolCmd.java\\nMap\\u003cString, String\\u003e | ImportUnmanagedInstanceCmd.java\\nMap | AddGuestOsCmd.java\\nMap | UpdateGuestOsCmd.java\\nMap | CreateDiskOfferingCmd.java\\n| List\\\\\\u003cString\\u003e | ListDomainsCmd.java\\nMap | CreateTemplateCmd.java\\nMap | GetUploadParamsForTemplateCmd.java\\nMap | RegisterTemplateCmd.java\\nList\\\\\\u003cString\\u003e | ListTemplatesCmd.java\\nList\\\\\\u003cString\\u003e | ListProjectsCmd.java\\nMap\\u003cString, String\\u003e | UpgradeVMCmd.java\\nList\\\\\\u003cString\\u003e | ListVMsCmd.java\\nMap | DeployVMCmd.java\\nMap\\u003cString, String\\u003e | UpdateVMCmd.java\\nMap | RestoreVMCmd.java\\n| Map\\u003cString, String\\u003e | ScaleVMCmd.java |\\n| List\\\\\\u003cString\\u003e | ListAccountsCmd.java |\\n| Map | AddResourceDetailCmd.java |\\n| | Responses: |\\n| Map\\u003cString, String\\u003e | TemplateResponse.java |\\nMap | NetworkOfferingResponse.java\\nMap | VolumeForImportResponse.java\\nString | DirectDownloadCertificateHostStatusResponse.java\\nMap | NetworkProtocolResponse.java\\nMap | UserVmResponse.java\\nMap | BgpPeerResponse.java\\nMap\\u003cString, String\\u003e | DiskOfferingResponse.java\\nMap | NetworkResponse.java\\nString | CreateConsoleEndpointResponse.java\\nString | RouterHealthCheckResultResponse.java\\nMap\\u003cString, List\\\\\\u003cString\\u003e\\u003e | DetailOptionsResponse.java\\nMap | HostResponse.java\\nString | UnmanageVMInstanceResponse.java\\n\\nIn addtion to these there are some details related parameters that also have different types i.e. \\u003csome entity type\\u003edetails and some of them even as boolean.\\n\\nThere are two improvements to make here:\\n1. make sure there are no ambiguities for users when they encounter a in- or output field named “details”\\n2. make sure maintainers do not mix different patterns for the same basic functionality\\nthe first being the more important one\\n\\nIn addition to all this there are backwards compatibility concerns. Some can be changed “under the hood” others will have to be marked as “deprecated\\\" to the user and and copied into a in-/output field with a new name, only considering the old one if the new one is missing.\\n\\n##### EXPECTED RESULTS\\nA clear pattern from both user and developer point of view.\\n\\n\",\"author_association\":\"CONTRIBUTOR\",\"user\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"labels\":[{\"id\":817420428,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:improvement\",\"name\":\"type:improvement\",\"color\":\"a5f9ff\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWw4MTc0MjA0Mjg=\"},{\"id\":821716113,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:cleanup\",\"name\":\"type:cleanup\",\"color\":\"0e8a16\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWw4MjE3MTYxMTM=\"},{\"id\":1900337335,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:technical-debt\",\"name\":\"type:technical-debt\",\"color\":\"52a8ea\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwxOTAwMzM3MzM1\"}],\"comments\":4,\"created_at\":\"2019-05-28T08:46:51Z\",\"updated_at\":\"2026-05-21T14:47:28Z\",\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/3360\",\"html_url\":\"https://github.com/apache/cloudstack/issues/3360\",\"comments_url\":\"https://api.github.com/repos/apache/cloudstack/issues/3360/comments\",\"events_url\":\"https://api.github.com/repos/apache/cloudstack/issues/3360/events\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/issues/3360/labels{/name}\",\"repository_url\":\"https://api.github.com/repos/apache/cloudstack\",\"milestone\":{\"url\":\"https://api.github.com/repos/apache/cloudstack/milestones/45\",\"html_url\":\"https://github.com/apache/cloudstack/milestone/45\",\"labels_url\":\"https://api.github.com/repos/apache/cloudstack/milestones/45/labels\",\"id\":14595362,\"number\":45,\"state\":\"open\",\"title\":\"4.20.4\",\"creator\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"open_issues\":135,\"closed_issues\":79,\"created_at\":\"2026-01-21T11:18:05Z\",\"updated_at\":\"2026-09-15T19:56:19Z\",\"node_id\":\"MI_kwDOAJTq2M4A3rUi\"},\"reactions\":{\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"confused\":0,\"heart\":0,\"hooray\":0,\"rocket\":0,\"eyes\":0,\"url\":\"https://api.github.com/repos/apache/cloudstack/issues/3360/reactions\"},\"node_id\":\"MDU6SXNzdWU0NDkxNDA5NTk=\",\"type\":{\"id\":93568,\"node_id\":\"IT_kwDNuP_OAAFtgA\",\"name\":\"Task\",\"description\":\"A specific piece of work\",\"color\":\"yellow\",\"created_at\":\"2024-01-25T09:11:09Z\",\"updated_at\":\"2024-07-26T10:04:57Z\"}},{\"id\":521445102,\"number\":3679,\"state\":\"open\",\"locked\":false,\"title\":\"marvin tests in plugin directory are not considered to be in python package\",\"body\":\"\\u003c!--\\r\\nVerify first that your issue/request is not already reported on GitHub.\\r\\nAlso test if the latest release and master branch are affected too.\\r\\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\\r\\n--\\u003e\\r\\nwhen creating tests in the `tests/integration/plugins` directory, and then executing them in a deployed marvin environment like trillian, local imports do not work. This makes it impossible to modularise tests for plugins to be reused in other environments. The `plugins` directory should work as the `smoke` and `component` directories do.\\r\\n\\r\\n##### ISSUE TYPE\\r\\n\\u003c!-- Pick one below and delete the rest --\\u003e\\r\\n * Improvement Request\\r\\n * Enhancement Request\\r\\n\\r\\n##### COMPONENT NAME\\r\\n\\u003c!--\\r\\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\\r\\n--\\u003e\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n##### CLOUDSTACK VERSION\\r\\n\\u003c!--\\r\\nNew line separated list of affected versions, commit ID for issues on master branch.\\r\\n--\\u003e\\r\\n\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n##### CONFIGURATION\\r\\n\\u003c!--\\r\\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\\r\\n--\\u003e\\r\\n\\r\\n\\r\\n##### OS / ENVIRONMENT\\r\\n\\u003c!--\\r\\nInformation about the environment if relevant, N/A otherwise\\r\\n--\\u003e\\r\\n\\r\\n\\r\\n##### SUMMARY\\r\\n\\u003c!-- Explain the problem/feature briefly --\\u003e\\r\\n\\r\\n\\r\\n##### STEPS TO REPRODUCE\\r\\n\\u003c!--\\r\\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\\r\\n\\r\\nFor new features, show how the feature would be used.\\r\\n--\\u003e\\r\\n\\r\\n\\u003c!-- Paste example playbooks or commands between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n\\u003c!-- You can also paste gist.github.com links for larger files --\\u003e\\r\\n\\r\\n##### EXPECTED RESULTS\\r\\n\\u003c!-- What did you expect to happen when running the steps above? --\\u003e\\r\\n\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\\r\\n##### ACTUAL RESULTS\\r\\n\\u003c!-- What actually happened? --\\u003e\\r\\n\\r\\n\\u003c!-- Paste verbatim command output between quotes below --\\u003e\\r\\n~~~\\r\\n\\r\\n~~~\\r\\n\",\"author_association\":\"CONTRIBUTOR\",\"user\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"MDQ6VXNlcjI0ODY5NjE=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/2486961?v=4\",\"html_url\":\"https://github.com/DaanHoogland\",\"gravatar_id\":\"\",\"type\":\"User\",\"site_admin\":false,\"url\":\"https://api.github.com/users/DaanHoogland\",\"events_url\":\"https://api.github.com/users/DaanHoogland/events{/privacy}\",\"following_url\":\"https://api.github.com/users/DaanHoogland/following{/other_user}\",\"followers_url\":\"https://api.github.com/users/DaanHoogland/followers\",\"gists_url\":\"https://api.github.com/users/DaanHoogland/gists{/gist_id}\",\"organizations_url\":\"https://api.github.com/users/DaanHoogland/orgs\",\"received_events_url\":\"https://api.github.com/users/DaanHoogland/received_events\",\"repos_url\":\"https://api.github.com/users/DaanHoogland/repos\",\"starred_url\":\"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/DaanHoogland/subscriptions\"},\"labels\":[{\"id\":817420428,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:improvement\",\"name\":\"type:improvement\",\"color\":\"a5f9ff\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWw4MTc0MjA0Mjg=\"},{\"id\":1900337335,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/type:technical-debt\",\"name\":\"type:technical-debt\",\"color\":\"52a8ea\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwxOTAwMzM3MzM1\"},{\"id\":2510052725,\"url\":\"https://api.github.com/repos/apache/cloudstack/labels/component:integration-test\",\"name\":\"component:integration-test\",\"color\":\"e858a2\",\"description\":\"\",\"default\":false,\"node_id\":\"MDU6TGFiZWwyNTEwMDUyNzI1\"}],\"assignee\":{\"login\":\"DaanHoogland\",\"id\":2486961,\"node_id\":\"M