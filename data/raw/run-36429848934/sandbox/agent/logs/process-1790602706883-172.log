m/repos/apache/cloudstack/milestones/19"},"node_id":"MDU6SXNzdWU3MTQ3OTMxMjY=","number":4370,"reactions":{"+1":1,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":1,"url":"https://api.github.com/repos/apache/cloudstack/issues/4370/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","state_reason":"reopened","title":"more fine grained categorisation for tests","type":{"color":"blue","created_at":"2024-01-25T09:11:09Z","description":"A request, idea, or new functionality","id":93574,"name":"Feature","node_id":"IT_kwDNuP_OAAFthg","updated_at":"2024-10-08T08:30:20Z"},"updated_at":"2026-05-08T12:09:40Z","url":"https://api.github.com/repos/apache/cloudstack/issues/4370","user":{"avatar_url":"https://avatars.githubusercontent.com/u/2486961?v=4","events_url":"https://api.github.com/users/DaanHoogland/events{/privacy}","followers_url":"https://api.github.com/users/DaanHoogland/followers","following_url":"https://api.github.com/users/DaanHoogland/following{/other_user}","gists_url":"https://api.github.com/users/DaanHoogland/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/DaanHoogland","id":2486961,"login":"DaanHoogland","node_id":"MDQ6VXNlcjI0ODY5NjE=","organizations_url":"https://api.github.com/users/DaanHoogland/orgs","received_events_url":"https://api.github.com/users/DaanHoogland/received_events","repos_url":"https://api.github.com/users/DaanHoogland/repos","site_admin":false,"starred_url":"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DaanHoogland/subscriptions","type":"User","url":"https://api.github.com/users/DaanHoogland"}},{"author_association":"CONTRIBUTOR","body":"<!--\r\nVerify first that your issue/request is not already reported on GitHub.\r\nAlso test if the latest release and master branch are affected too.\r\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\r\n-->\r\nAbility to define IP address beside of choosing VMs in Static NAT, Port Forward and Load balancer services to provide those services to servers outside of CloudStack.\r\n##### ISSUE TYPE\r\n<!-- Pick one below and delete the rest -->\r\n * Feature Idea\r\n\r\n##### COMPONENT NAME\r\n<!--\r\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\r\n-->\r\n~~~\r\nVR\r\n~~~\r\n\r\n##### CLOUDSTACK VERSION\r\n<!--\r\nNew line separated list of affected versions, commit ID for issues on master branch.\r\n-->\r\n\r\n~~~\r\nAll versions\r\n~~~\r\n\r\n##### CONFIGURATION\r\n<!--\r\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\r\n-->\r\nAdvanced networking\r\n\r\n##### OS / ENVIRONMENT\r\n<!--\r\nInformation about the environment if relevant, N/A otherwise\r\n-->\r\nN/A\r\n\r\n##### SUMMARY\r\n<!-- Explain the problem/feature briefly -->\r\n\r\nIn some network services we need to specify which VM should use it. For example Static NAT, Port Forward and Load balancer.\r\nIt would be a good idea if we can also specify IP address of a server which is not managed by CloudStack.\r\nThis feature helps us to use network services provided by virtual router for physical servers or even VMs outside of CloudStack management area but share a common L2 network with other VMs in CloudStack.\r\nThis feature also requires reserve IP address capability in all type of networks. We can expand the issue #4357 for private IPs in isolated networks too.\r\n\r\n##### STEPS TO REPRODUCE\r\n<!--\r\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\r\n\r\nFor new features, show how the feature would be used.\r\n-->\r\n\r\n<!-- Paste example playbooks or commands between quotes below -->\r\n~~~\r\n\r\n1. Create an isolated network\r\n2. In Port forward section define a new rule\r\n3. In \"Add VM\" panel write IP address of the server outside of CloudStack\r\n\r\n~~~\r\n\r\n<!-- You can also paste gist.github.com links for larger files -->\r\n\r\n##### EXPECTED RESULTS\r\n<!-- What did you expect to happen when running the steps above? -->\r\n\r\n~~~\r\n\r\nAn iptables rule created in virtual router to forward desired port to the server IP\r\n\r\n~~~\r\n\r\n##### ACTUAL RESULTS\r\n<!-- What actually happened? -->\r\n\r\n<!-- Paste verbatim command output between quotes below -->\r\n~~~\r\n\r\nIt is not possible to mention IP address of the server outside of CloudStack\r\n\r\n~~~\r\n","comments":26,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/4542/comments","created_at":"2020-12-14T13:58:37Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/4542/events","html_url":"https://github.com/apache/cloudstack/issues/4542","id":766468471,"labels":[{"color":"f9d0c4","default":false,"description":"","id":592559219,"name":"component:networking","node_id":"MDU6TGFiZWw1OTI1NTkyMTk=","url":"https://api.github.com/repos/apache/cloudstack/labels/component:networking"},{"color":"c1fca4","default":false,"description":"","id":2249631279,"name":"type:experimental-feature","node_id":"MDU6TGFiZWwyMjQ5NjMxMjc5","url":"https://api.github.com/repos/apache/cloudstack/labels/type:experimental-feature"},{"color":"000088","default":false,"description":"a few days to a couple of weeks","id":2531618875,"name":"complexity:simple","node_id":"MDU6TGFiZWwyNTMxNjE4ODc1","url":"https://api.github.com/repos/apache/cloudstack/labels/complexity:simple"},{"color":"aaaaaa","default":false,"description":"remove this label if you plan to pick up this issue.","id":9851088157,"name":"long-term-plan","node_id":"LA_kwDOAJTq2M8AAAACSyutHQ","url":"https://api.github.com/repos/apache/cloudstack/labels/long-term-plan"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/4542/labels{/name}","locked":false,"milestone":{"closed_issues":1302,"created_at":"2021-01-04T09:07:50Z","creator":{"avatar_url":"https://avatars.githubusercontent.co