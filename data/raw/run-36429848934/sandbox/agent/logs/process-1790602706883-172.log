/milestones/19"},"node_id":"MDU6SXNzdWU5MzM5MDUwNDY=","number":5174,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/apache/cloudstack/issues/5174/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","title":"methods implemented twice in marvin code","type":{"color":"yellow","created_at":"2024-01-25T09:11:09Z","description":"A specific piece of work","id":93568,"name":"Task","node_id":"IT_kwDNuP_OAAFtgA","updated_at":"2024-07-26T10:04:57Z"},"updated_at":"2026-05-06T02:17:01Z","url":"https://api.github.com/repos/apache/cloudstack/issues/5174","user":{"avatar_url":"https://avatars.githubusercontent.com/u/2486961?v=4","events_url":"https://api.github.com/users/DaanHoogland/events{/privacy}","followers_url":"https://api.github.com/users/DaanHoogland/followers","following_url":"https://api.github.com/users/DaanHoogland/following{/other_user}","gists_url":"https://api.github.com/users/DaanHoogland/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/DaanHoogland","id":2486961,"login":"DaanHoogland","node_id":"MDQ6VXNlcjI0ODY5NjE=","organizations_url":"https://api.github.com/users/DaanHoogland/orgs","received_events_url":"https://api.github.com/users/DaanHoogland/received_events","repos_url":"https://api.github.com/users/DaanHoogland/repos","site_admin":false,"starred_url":"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DaanHoogland/subscriptions","type":"User","url":"https://api.github.com/users/DaanHoogland"}},{"author_association":"NONE","body":"##### ISSUE TYPE\r\n * Improvement Request\r\n\r\n##### COMPONENT NAME\r\n\r\n~~~\r\ncloudstack-sysvmadm\r\n~~~\r\n\r\n##### CLOUDSTACK VERSION\r\n~~~\r\nN/A\r\n~~~\r\n\r\n##### CONFIGURATION\r\n\r\nN/A\r\n\r\n##### OS / ENVIRONMENT\r\nCloudstack running on linux systems\r\n\r\n##### SUMMARY\r\nCheck filesystem permission before upgrading systemvms\r\n\r\n##### STEPS TO REPRODUCE\r\n<!--\r\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\r\n\r\nFor new features, show how the feature would be used.\r\n-->\r\nCurrently, when issuing the cloudstack-sysvmadm script for upgrading the systemvms (or doing it manually), the process starts without any prechecks.\r\nWhen there is somehow an issue with filesystem permissions, the new systemvm.iso cannot be copied to the new location.  It would be a nice enhancement, when cloudstack had a health check or at least the cloudstack-sysvmadm script a permission check.\r\n\r\nA newly introduced health check could continuously check some relevant cloudstack metrics, including the filesystem permissions and show a simple go/nogo somewhere in the admin ui. Or the simple way: a script or the modified sysvmadm script which checks first all storage paths for the correct rights. \r\n\r\n\r\n\r\n<!-- Paste example playbooks or commands between quotes below -->\r\n~~~\r\n\r\n~~~\r\n\r\n<!-- You can also paste gist.github.com links for larger files -->\r\n\r\n##### EXPECTED RESULTS\r\n<!-- What did you expect to happen when running the steps above? -->\r\n\r\n~~~\r\n\r\n~~~\r\n\r\n##### ACTUAL RESULTS\r\n<!-- What actually happened? -->\r\n\r\n<!-- Paste verbatim command output between quotes below -->\r\n~~~\r\n\r\n~~~\r\n","comments":4,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/5686/comments","created_at":"2021-11-15T08:17:23Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/5686/events","html_url":"https://github.com/apache/cloudstack/issues/5686","id":1053343038,"labels":[{"color":"84b6eb","default":false,"description":"","id":37843366,"name":"type:enhancement","node_id":"MDU6TGFiZWwzNzg0MzM2Ng==","url":"https://api.github.com/repos/apache/cloudstack/labels/type:enhancement"},{"color":"720bc1","default":false,"description":"","id":814277974,"name":"component:upgrade","node_id":"MDU6TGFiZWw4MTQyNzc5NzQ=","url":"https://api.github.com/repos/apache/cloudstack/labels/component:upgrade"},{"color":"E43179","default":false,"description":"","id":6890295339,"name":"status:stale","node_id":"LA_kwDOAJTq2M8AAAABmrGQKw","url":"https://api.github.com/repos/apache/cloudstack/labels/status:stale"},{"color":"ededed","default":false,"id":9849008471,"name":"no-issue-activity","node_id":"LA_kwDOAJTq2M8AAAACSwvxVw","url":"https://api.github.com/repos/apache/cloudstack/labels/no-issue-activity"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/5686/labels{/name}","locked":false,"milestone":{"closed_issues":1302,"created_at":"2021-01-04T09:07:50Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/2486961?v=4","events_url":"https://api.github.com/users/DaanHoogland/events{/privacy}","followers_url":"https://api.github.com/users/DaanHoogland/followers","following_url":"https://api.github.com/users/DaanHoogland/following{/other_user}","gists_url":"https://api.github.com/users/DaanHoogland/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/DaanHoogland","id":2486961,"login":"DaanHoogland","node_id":"MDQ6VXNlcjI0ODY5NjE=","organizations_url":"https://api.github.com/users/DaanHoogland/orgs","received_events_url":"https://api.github.com/users/DaanHoogland/received_events","repos_url":"https://api.github.com/users/DaanHoogland/repos","site_admin":false,"starred_url":"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DaanHoogland/subscriptions","type":"User","url":"https://api.github.com/users/DaanHoogland"},"html_url":"https://github.com/apache/cloudstack/milestone/19","id":6265435,"labels_url":"https://api.github.com/repos/apache/cloudstack/milestones/19/labels","node_id":"MDk6TWlsZXN0b25lNjI2NTQzNQ==","number":19,"open_issues":185,"state":"open","title":"unplanned","updated_at":"2026-09-24T11:01:33Z","url":"https://api.github.com/repos/apache/cloudstack/milestones/19"},"node_id":"I_kwDOAJTq2M4-yL0-","number":5686,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/apache/cloudstack/issues/5686/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","title":"Improvement: Filesystem permission check","type":{"color":"blue","created_at":"2024-01-25T09:11:09Z","description":"A request, idea, or new functionality","id":93574,"name":"Feature","node_id":"IT_kwDNuP_OAAFthg","updated_at":"2024-10-08T08:30:20Z"},"updated_at":"2026-05-06T02:17:00Z","url":"https://api.github.com/repos/apache/cloudstack/issues/5686","user":{"avatar_url":"https://avatars.githubusercontent.com/u/71492633?v=4","events_url":"https://api.github.com/users/ngrosc/events{/privacy}","followers_url":"https://api.github.com/users/ngrosc/followers","following_url":"https://api.github.com/users/ngrosc/following{/other_user}","gists_url":"https://api.github.com/users/ngrosc/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/ngrosc","id":71492633,"login":"ngrosc","node_id":"MDQ6VXNlcjcxNDkyNjMz","organizations_url":"https://api.github.com/users/ngrosc/orgs","received_events_url":"https://api.github.com/users/ngrosc/received_events","repos_url":"https://api.github.com/users/ngrosc/repos","site_admin":false,"starred_url":"https://api.github.com/users/ngrosc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngrosc/subscriptions","type":"User","url":"https://api.github.com/users/ngrosc"}},{"author_association":"CONTRIBUTOR","body":"At the moment when a template is being imported (via url or upload) there is a phase called \"Installing template\" or something similar. From what I noticed this phase calculates a hash and saves it to the database by reading the downloaded file over the storage network.\r\nDuring this phase the template is not usable and I believe that should not be the case. I understand that the hash has a purpose and I am not saying it should be removed but I believe this should be an optional task that should be done in background.\r\n\r\nIn the following examples I do not consider disk speeds, just network speed/bandwidth.\r\nFor normal templates this is not necessarily noticeable. Consider this scenario (best case):\r\nTemplate size: 4GB\r\nIngress bandwidth: 100 mb/s\r\nStorage bandwidth: 1 gb/s\r\nDownload time required: 5.45 seconds\r\nInstalling template time required: ~0.6 seconds\r\n\r\nMost templates (not ISOs) however are considerably larger, some could be even up to 500 GB (I do have a few templates that I have to import with very large sizes).\r\nIn such a case, installing template time required would be about 75 seconds (best case). \r\n\r\nDuring this time (installing template time) the whole bandwidth available for the storage network (if it even is on a separate NIC) would be used up by this process resulting in bad performance for the cluster. \r\n\r\nWays to fix this would be:\r\n  1. either compute the hash as the transfer is happening.\r\n  2. make it optional (maybe even opt-in) and do it in background only (maybe even limit the bandwidth used for this)","comments":6,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/5697/comments","created_at":"2021-11-18T00:42:50Z","events_url":"https://api.github.com/repos/apache/cloudstack/issues/5697/events","html_url":"https://github.com/apache/cloudstack/issues/5697","id":1056795111,"labels":[{"color":"f9d0c4","default":false,"description":"","id":584073307,"name":"component:secondary-storage","node_id":"MDU6TGFiZWw1ODQwNzMzMDc=","url":"https://api.github.com/repos/apache/cloudstack/labels/component:secondary-storage"},{"color":"a5f9ff","default":false,"description":"","id":817420428,"name":"type:improvement","node_id":"MDU6TGFiZWw4MTc0MjA0Mjg=","url":"https://api.github.com/repos/apache/cloudstack/labels/type:improvement"},{"color":"ef97b6","default":false,"description":"","id":1152969966,"name":"component:templates","node_id":"MDU6TGFiZWwxMTUyOTY5OTY2","url":"https://api.github.com/repos/apache/cloudstack/labels/component:templates"},{"color":"E43179","default":false,"description":"","id":6890295339,"name":"status:stale","node_id":"LA_kwDOAJTq2M8AAAABmrGQKw","url":"https://api.github.com/repos/apache/cloudstack/labels/status:stale"},{"color":"ededed","default":false,"id":9849008471,"name":"no-issue-activity","node_id":"LA_kwDOAJTq2M8AAAACSwvxVw","url":"https://api.github.com/repos/apache/cloudstack/labels/no-issue-activity"}],"labels_url":"https://api.github.com/repos/apache/cloudstack/issues/5697/labels{/name}","locked":false,"milestone":{"closed_issues":1302,"created_at":"2021-01-04T09:07:50Z","creator":{"avatar_url":"https://avatars.githubusercontent.com/u/2486961?v=4","events_url":"https://api.github.com/users/DaanHoogland/events{/privacy}","followers_url":"https://api.github.com/users/DaanHoogland/followers","following_url":"https://api.github.com/users/DaanHoogland/following{/other_user}","gists_url":"https://api.github.com/users/DaanHoogland/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/DaanHoogland","id":2486961,"login":"DaanHoogland","node_id":"MDQ6VXNlcjI0ODY5NjE=","organizations_url":"https://api.github.com/users/DaanHoogland/orgs","received_events_url":"https://api.github.com/users/DaanHoogland/received_events","repos_url":"https://api.github.com/users/DaanHoogland/repos","site_admin":false,"starred_url":"https://api.github.com/users/DaanHoogland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DaanHoogland/subscriptions","type":"User","url":"https://api.github.com/users/DaanHoogland"},"html_url":"https://github.com/apache/cloudstack/milestone/19","id":6265435,"labels_url":"https://api.github.com/repos/apache/cloudstack/milestones/19/labels","node_id":"MDk6TWlsZXN0b25lNjI2NTQzNQ==","number":19,"open_issues":185,"state":"open","title":"unplanned","updated_at":"2026-09-24T11:01:33Z","url":"https://api.github.com/repos/apache/cloudstack/milestones/19"},"node_id":"I_kwDOAJTq2M4-_Wnn","number":5697,"reactions":{"+1":0,"-1":0,"confused":0,"eyes":0,"heart":0,"hooray":0,"laugh":0,"rocket":0,"total_count":0,"url":"https://api.github.com/repos/apache/cloudstack/issues/5697/reactions"},"repository_url":"https://api.github.com/repos/apache/cloudstack","state":"open","title":"Storage bandwidth is wasted during template uploads/imports","type":{"color":"blue","created_at":"2024-01-25T09:11:09Z","description":"A request, idea, or new functionality","id":93574,"name":"Feature","node_id":"IT_kwDNuP_OAAFthg","updated_at":"2024-10-08T08:30:20Z"},"updated_at":"2026-05-06T02:16:58Z","url":"https://api.github.com/repos/apache/cloudstack/issues/5697","user":{"avatar_url":"https://avatars.githubusercontent.com/u/5436943?v=4","events_url":"https://api.github.com/users/alexandru-bagu/events{/privacy}","followers_url":"https://api.github.com/users/alexandru-bagu/followers","following_url":"https://api.github.com/users/alexandru-bagu/following{/other_user}","gists_url":"https://api.github.com/users/alexandru-bagu/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/alexandru-bagu","id":5436943,"login":"alexandru-bagu","node_id":"MDQ6VXNlcjU0MzY5NDM=","organizations_url":"https://api.github.com/users/alexandru-bagu/orgs","received_events_url":"https://api.github.com/users/alexandru-bagu/received_events","repos_url":"https://api.github.com/users/alexandru-bagu/repos","site_admin":false,"starred_url":"https://api.github.com/users/alexandru-bagu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexandru-bagu/subscriptions","type":"User","url":"https://api.github.com/users/alexandru-bagu"}},{"assignee":{"avatar_url":"https://avatars.githubusercontent.com/u/5295080?v=4","events_url":"https://api.github.com/users/nvazquez/events{/privacy}","followers_url":"https://api.github.com/users/nvazquez/followers","following_url":"https://api.github.com/users/nvazquez/following{/other_user}","gists_url":"https://api.github.com/users/nvazquez/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/nvazquez","id":5295080,"login":"nvazquez","node_id":"MDQ6VXNlcjUyOTUwODA=","organizations_url":"https://api.github.com/users/nvazquez/orgs","received_events_url":"https://api.github.com/users/nvazquez/received_events","repos_url":"https://api.github.com/users/nvazquez/repos","site_admin":false,"starred_url":"https://api.github.com/users/nvazquez/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nvazquez/subscriptions","type":"User","url":"https://api.github.com/users/nvazquez"},"assignees":[{"avatar_url":"https://avatars.githubusercontent.com/u/5295080?v=4","events_url":"https://api.github.com/users/nvazquez/events{/privacy}","followers_url":"https://api.github.com/users/nvazquez/followers","following_url":"https://api.github.com/users/nvazquez/following{/other_user}","gists_url":"https://api.github.com/users/nvazquez/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/nvazquez","id":5295080,"login":"nvazquez","node_id":"MDQ6VXNlcjUyOTUwODA=","organizations_url":"https://api.github.com/users/nvazquez/orgs","received_events_url":"https://api.github.com/users/nvazquez/received_events","repos_url":"https://api.github.com/users/nvazquez/repos","site_admin":false,"starred_url":"https://api.github.com/users/nvazquez/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nvazquez/subscriptions","type":"User","url":"https://api.github.com/users/nvazquez"}],"author_association":"MEMBER","body":"<!--\r\nVerify first that your issue/request is not already reported on GitHub.\r\nAlso test if the latest release and main branch are affected too.\r\nAlways add information AFTER of these HTML comments, but no need to delete the comments.\r\n-->\r\n\r\n##### ISSUE TYPE\r\n<!-- Pick one below and delete the rest -->\r\n\r\n * Feature Idea\r\n\r\n##### COMPONENT NAME\r\n<!--\r\nCategorize the issue, e.g. API, VR, VPN, UI, etc.\r\n-->\r\n~~~\r\nUI\r\n~~~\r\n\r\n##### CLOUDSTACK VERSION\r\n<!--\r\nNew line separated list of affected versions, commit ID for issues on main branch.\r\n-->\r\n\r\n~~~\r\n4.16+\r\n~~~\r\n\r\n##### CONFIGURATION\r\n<!--\r\nInformation about the configuration if relevant, e.g. basic network, advanced networking, etc.  N/A otherwise\r\n-->\r\nNA\r\n\r\n##### OS / ENVIRONMENT\r\n<!--\r\nInformation about the environment if relevant, N/A otherwise\r\n-->\r\nNA\r\n\r\n##### SUMMARY\r\n<!-- Explain the problem/feature briefly -->\r\n\r\nWhen a user deployment fails, user ends up with an instance with has a status of `Error`\r\n\r\n![image](https://user-images.githubusercontent.com/4810220/144216638-99ea0b7e-90d0-4d30-ab10-8f4b17ca33cd.png)\r\n\r\nThey will usually then report it to the CloudStack administrators. \r\nOften the problem is in the backend/infrastructure.  The administrators fix the issue and say 'try now'.\r\n\r\nIt would be a nice touch to be able to 'retry' the instance deployment, rather than have to start again.\r\n\r\n##### STEPS TO REPRODUCE\r\n<!--\r\nFor bugs, show exactly how to reproduce the problem, using a minimal test-case. Use Screenshots if accurate.\r\n\r\nFor new features, show how the feature would be used.\r\n-->\r\n\r\n<!-- Paste example playbooks or commands between quotes below -->\r\n~~~\r\n\r\n~~~\r\n\r\n<!-- You can also paste gist.github.com links for larger files -->\r\n\r\n##### EXPECTED RESULTS\r\n<!-- What did you expect to happen when running the steps above? -->\r\n\r\n~~~\r\n\r\n~~~\r\n\r\n##### ACTUAL RESULTS\r\n<!-- What actually happened? -->\r\n\r\n<!-- Paste verbatim command output between quotes below -->\r\n~~~\r\n\r\n~~~\r\n","comments":3,"comments_url":"https://api.github.com/repos/apache/cloudstack/issues/5739/comments","created_at":"2021-12-01T10:23:38Z","events_url":"https://api.github.com/repos/apache/cloudstack/i